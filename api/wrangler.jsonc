{
  "name": "openwaters-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // No routes: api.openwaters.io lives on the gateway worker (gateway/), which
  // dispatches /tides* here via a service binding.
  "workers_dev": true,
  "preview_urls": true,
  // The website's dev server defaults to the API on 3001.
  "dev": { "port": 3001 }
}
