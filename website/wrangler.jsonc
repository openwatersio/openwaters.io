{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openwaters-io",
  // Wraps @astrojs/cloudflare's handler; the adapter fills in the assets directory.
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    // Pages are negotiated (HTML or Markdown) in src/worker.ts, so their requests must
    // reach the Worker; everything with an extension is served straight from assets.
    "run_worker_first": ["/*", "!/*.*", "!/_astro/*", "!/og/*"],
  },
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "openwaters.io", "custom_domain": true },
    { "pattern": "www.openwaters.io", "custom_domain": true },
  ],
  // Routes disable these by default; keep the generated URL and PR previews.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
}
