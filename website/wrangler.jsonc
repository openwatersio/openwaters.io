{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openwaters-io",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "build": {
    // DEPLOY_TARGET selects the Cloudflare adapter in astro.config.mjs.
    // PUBLIC_TIDES_API_URL is baked in at build time; env wins so cutover/CI can
    // point at api.openwaters.io.
    // api-cf, not workers.dev: same-account worker-to-worker fetches over
    // workers.dev are blocked (error 1042).
    "command": "DEPLOY_TARGET=cloudflare PUBLIC_TIDES_API_URL=${PUBLIC_TIDES_API_URL:-https://api-cf.openwaters.io} npm run build",
  },
  "observability": {
    "enabled": true,
  },
}
