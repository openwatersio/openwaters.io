{
  "name": "openwaters-io",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm ls --depth=0 >/dev/null 2>&1 || { npm ls --depth=0 2>&1 | grep -iE 'invalid|missing' | head -5; echo ''; echo 'Installed dependencies do not match package.json — run `npm ci` from the repo root.'; echo 'A stale install fails astro check with missing exports, which reads as broken code.'; exit 1; }",
    "build": "astro check && astro build",
    "format": "prettier --write .",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "test": "node --test \"src/**/*.test.ts\"",
    "og:ais": "node scripts/og-ais.mjs",
    "check:station-redirects": "node scripts/check-station-redirects.mjs",
    "check:codeblock": "node scripts/check-codeblock-token.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/react": "^6.0.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@openwaters/almanac": "^0.11.0",
    "@openwaters/seascape": "^0.4.0",
    "@slackwater/api": "^1.0.0-beta.3",
    "@slackwater/database": "^1.0.0-beta.20261028",
    "@slackwater/engine": "^1.0.0-beta.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "coordinate-format": "^1.0.0",
    "maplibre-gl": "^6.15.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "shiki": "^4.5.0",
    "slackwater": "^1.0.0-beta.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turndown": "^7.2.4"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
