---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";
import { cn } from "../utils/cn";
import { CONTACT_EMAIL } from "../utils/constants";
import { jsonLd, organization } from "../utils/schema";

interface Props {
  title?: string;
  description?: string;
  image?: string; // site-relative path to a preview image for link unfurls
  fullscreen?: boolean;
  /** Page-specific JSON-LD. Organization is emitted on every page regardless. */
  schema?: unknown;
}

const {
  title = "Open Waters - Open Source Marine Software and Data",
  description = "Open source tools and data for understanding and navigating the sea. Tide predictions, bathymetry, and more.",
  image = "/og/openwaters.png",
  fullscreen = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const fullTitle =
  title === "Open Waters - Open Source Marine Software and Data"
    ? title
    : `${title} | Open Waters`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Open Waters" />
    <meta property="og:image" content={imageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(organization(CONTACT_EMAIL))}
    />
    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={jsonLd(schema)}
        />
      )
    }

    <script is:inline>
      const m = window.matchMedia("(prefers-color-scheme: dark)");
      document.documentElement.classList.toggle("dark", m.matches);
      m.addEventListener("change", (e) =>
        document.documentElement.classList.toggle("dark", e.matches),
      );
    </script>

    <script
      is:inline
      defer
      data-domain="openwaters.io"
      src="https://plausible.io/js/script.js"></script>
  </head>
  <body
    class={cn({ "flex min-h-screen flex-col": true, fullscreen: fullscreen })}
  >
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
