---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import AisNav from "../../components/ais/AisNav.astro";
import { md } from "../../utils/render-markdown";

// The policy's one source is the aiscast repository; the site re-publishes it
// on every build. The branch URL covers the window before aiscast#37 merges.
// AIS_PRIVACY_POLICY_URL points a local build at a draft.
const SOURCES = [
  import.meta.env.AIS_PRIVACY_POLICY_URL,
  "https://raw.githubusercontent.com/openwatersio/aiscast/main/docs/privacy-policy.md",
  "https://raw.githubusercontent.com/openwatersio/aiscast/privacy-policy/docs/privacy-policy.md",
].filter(Boolean) as string[];

async function fetchPolicy() {
  for (const url of SOURCES) {
    try {
      const res = await fetch(url, { signal: AbortSignal.timeout(10_000) });
      if (res.ok) return res.text();
      console.warn(`[ais] privacy policy ${url}: ${res.status}`);
    } catch (err) {
      console.warn(`[ais] privacy policy ${url}: ${err}`);
    }
  }
  throw new Error("AIS privacy policy unavailable from every source");
}
const text = await fetchPolicy();
// A draft with an unfilled placeholder such as "[LAUNCH DATE]" must not ship.
const placeholder = text.match(/\[[A-Z][A-Z ]+\]/);
if (placeholder)
  throw new Error(
    `AIS privacy policy still has a placeholder: ${placeholder[0]}`,
  );

// The document's own h1 becomes the page heading.
const heading = text.match(/^# (.+)$/m);
const title = heading?.[1] ?? "Privacy policy";
const body = heading ? text.replace(heading[0], "") : text;
---

<MainLayout
  title={title}
  image="/og/ais.png"
  description="What the Open Waters AIS network keeps about vessels, stations, tokens, and API requests, for how long, and who to ask."
>
  <Container class="py-12 lg:py-16">
    <div class="mx-auto max-w-3xl">
      <AisNav class="mb-8" />
      <h1 class="mb-8">{title}</h1>
      <div class="prose prose-lg max-w-none" set:html={md(body)} />
    </div>
  </Container>
</MainLayout>
