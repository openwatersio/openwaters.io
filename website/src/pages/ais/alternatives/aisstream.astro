---
import MainLayout from "../../../layouts/MainLayout.astro";
import Container from "../../../components/ui/Container.astro";
import Card from "../../../components/ui/Card.astro";
import CodeBlock from "../../../components/ui/CodeBlock.astro";
import Icon from "../../../components/Icon.astro";
import { CONTACT_EMAIL } from "../../../utils/constants";
import { SITE, publisher } from "../../../utils/schema";

const DESCRIPTION =
  "Whether aisstream.io is delivering right now, measured live from our own subscription, plus its 2026 outage record and alternatives that keep your stream running.";

const STATS = "https://ais.openwaters.io/v1/stats";
const ISSUES = "https://github.com/aisstream/issues/issues/";

const sections = [
  { id: "status", label: "Is it down right now?" },
  { id: "record", label: "Outage record" },
  { id: "why", label: "Why people look for an alternative" },
  { id: "criteria", label: "What to look for" },
  { id: "alternatives", label: "The alternatives" },
  { id: "glance", label: "At a glance" },
  { id: "which", label: "Which one" },
  { id: "switch", label: "Switching to Open Waters AIS" },
  { id: "faq", label: "FAQ" },
];

const issue = (n: number) =>
  `<a href='${ISSUES}${n}' target='_blank' rel='noopener noreferrer'>#${n}</a>`;

// Each entry cites the aisstream issue threads it summarizes, so a reader can check
// the claim and its date against the operator's own tracker.
const record: { when: string; html: string }[] = [
  {
    when: "5–17 August 2026",
    html: `Connections and subscriptions were accepted, but no messages arrived, from 13:31 UTC on 5 August (${issue(257)}, ${issue(269)}) until about 17 August (${issue(273)}).`,
  },
  {
    when: "19–22 August 2026",
    html: `Silent again from 06:18 UTC on 19 August until 22 August (${issue(279)}). aisstream's statement in that thread attributes the outage to a bug in circuit-breaker logic added to handle a sharp rise in load, and says its small team had limited internet access at the time.`,
  },
  {
    when: "Early September 2026",
    html: `Stale subscriptions held accounts at the three-connection limit and refused new connections with HTTP 429 for days, until aisstream restarted its load balancer and deployed a fix (${issue(292)}).`,
  },
  {
    when: "September 2026",
    html: `Connections closing immediately with code 1006 on every attempt (${issue(291)}). On 14 September aisstream said in that thread that it was very close to bandwidth capacity.`,
  },
];

// Bullet bodies carry inline markup (code spans, links), so they are authored as HTML
// here and rendered with set:html rather than repeating the list markup six times.
const alternatives: {
  name: string;
  intro?: string;
  bullets: { label: string; html: string }[];
  best: string;
}[] = [
  {
    name: "Open Waters AIS",
    intro:
      "An open AIS network for real-time vessel tracking and historical analysis, with an aisstream-compatible stream and a REST API for vessel tracks.",
    bullets: [
      {
        label: "Real-time tracking",
        html: "WebSocket push, bounding box or MMSI list. <code>/v0/stream</code> is aisstream-compatible: change the hostname, use your Open Waters AIS token as <code>APIKey</code>, and <code>aisstream-ts</code>, the official Go/Python/JS examples, and <code>signalk-aisstream</code> run unmodified. <code>/v1/stream</code> is the native API and needs no token to subscribe. REST vessel lookups support applications that poll rather than keep a stream open.",
      },
      {
        label: "Historical analysis",
        html: "<a href='/api/ais/#get-v1-vessels-mmsi-track'>Vessel tracks</a> return recorded positions for a requested time range as GeoJSON or GPX. Each request can span up to 366 days; that is a query limit, not a guarantee of a year of coverage. Available dates and detail depend on the vessel, source, and access tier. For a historical project, <a href='/contact/'>send us your vessels, area, and dates</a> to check the fit.",
      },
      {
        label: "Coverage",
        html: "live from the Norwegian and Finnish coastal authorities and from volunteer receivers; worldwide terrestrial via the AISHub snapshot, which runs about a minute behind (<a href='https://ais.openwaters.io/v1/stats' target='_blank' rel='noopener noreferrer'><code>/v1/stats</code></a> reports each source's current delay); aisstream.io itself as an upstream when it is up. Every event names its source and station, and <code>/v1/stations</code> shows each source's message rate and age, so you can tell a gap from a fault.",
      },
      {
        label: "Price",
        html: "free without a token (2 streams, 20 msg/s, about 10°×10°); free personal token in one click, never expires (2 streams, 50 msg/s, about 20°×20°, or 50 vessels by MMSI anywhere); contributor tier is earned by contributing a receiver; free access is for personal use; commercial products should <a href='/contact/'>contact us</a> for terms and a quote.",
      },
      {
        label: "License",
        html: "per source, published, with the attribution string you must carry. Norway NLOD, Finland CC BY 4.0, volunteer receptions CC0 with the aggregate under ODbL, AISHub with attribution. Code is MIT.",
      },
      {
        label: "Operations",
        html: 'subscription ack, heartbeat, close reasons, documented limits per token rather than per IP, a public status page at <a href="https://status.openwaters.io" target="_blank" rel="noopener noreferrer">status.openwaters.io</a>, and hello@openwaters.io answers.',
      },
      {
        label: "Honest limits",
        html: "standard access is best effort. Coverage and latency vary by source; AISHub positions are typically about a minute behind. Historical tracks only contain positions the network holds, and gaps remain gaps. Check the required vessels and dates before relying on the data; contact us about bulk datasets or contractual requirements. This is not a global satellite feed or a service for safety of navigation.",
      },
    ],
    best: "developers building vessel tracking, fleet monitoring, and marine apps; analysts and researchers reconstructing vessel movements over time.",
  },
  {
    name: "AISHub",
    intro:
      "A community AIS network built by receiver operators. Contribute your station’s receptions and get access to the combined data. Open Waters AIS contributes to AISHub and uses its aggregate for much of our worldwide terrestrial coverage.",
    bullets: [
      {
        label: "Protocol",
        html: "a REST API with snapshots in JSON, XML, or CSV, queried at most once a minute. The worldwide snapshot refreshes about once a minute, so positions are typically about a minute behind.",
      },
      {
        label: "Coverage",
        html: "worldwide terrestrial coverage contributed by receiver operators. Their shared receptions are an important part of the coverage available through Open Waters AIS.",
      },
      {
        label: "Price",
        html: "free API access for contributors whose stations meet the published requirements: a seven-day average of at least 10 vessels and 90% uptime, with at most 60 seconds downsampling and 10 seconds message delay. <a href='https://www.aishub.net/join-us'>See how to join AISHub</a>.",
      },
      {
        label: "License",
        html: "AISHub publishes <a href='https://www.aishub.net/join-us'>terms for contributors and data use</a>. Credit AISHub contributors and check the terms for your project, including any redistribution.",
      },
      {
        label: "Honest limits",
        html: "the API provides periodic snapshots rather than a push stream. API access requires an operational receiver meeting the contribution requirements. AIS data is not for safety of navigation.",
      },
    ],
    best: "receiver operators who want a worldwide view of vessel traffic while contributing to a shared community network.",
  },
  {
    name: "Open government feeds directly (Digitraffic, Kystverket, BarentsWatch, EuRIS)",
    intro: "The sources Open Waters AIS is built on, available to anyone.",
    bullets: [
      {
        label: "Protocol",
        html: "Finland pushes over MQTT/WSS; Norway is a raw TCP socket of tagged NMEA; BarentsWatch is JSON and Kafka behind a free OAuth client; EuRIS is a REST bounding-box endpoint for EU inland waterways.",
      },
      {
        label: "Coverage",
        html: "Finnish waters, the Norwegian coast to about 60 nm plus the EEZ and Svalbard, and 13 countries of European rivers and canals (anonymised: no MMSI or name).",
      },
      {
        label: "Price",
        html: "free, no registration except BarentsWatch.",
      },
      {
        label: "License",
        html: "CC BY 4.0, NLOD 2.0, and an attribution string for EuRIS. Redistribution explicitly allowed.",
      },
      {
        label: "Honest limits",
        html: "three protocols, three reconnect loops, your own dedupe, and nothing outside those waters.",
      },
    ],
    best: "Nordic-only projects and anyone who wants to own the whole pipeline.",
  },
  {
    name: "VesselFinder API",
    bullets: [
      {
        label: "Protocol",
        html: "REST, credit-based, built for per-vessel lookups. A raw TCP/UDP feed exists on quote, priced by area and traffic density.",
      },
      { label: "Coverage", html: "global terrestrial plus satellite." },
      {
        label: "Historical analysis",
        html: "<a href='https://www.vesselfinder.com/historical-ais-data'>Historical datasets</a> for vessels, ports, or areas, delivered as CSV or XLS. Confirm the dates and resolution available for your request.",
      },
      {
        label: "Price",
        html: "€330 for 10,000 credits, €625 for 20,000, €1,470 for 50,000. A terrestrial position is one credit, satellite ten.",
      },
      {
        label: "License",
        html: "the terms ban competing vessel-tracking services and AI training; external display is allowed only where your order says so.",
      },
      {
        label: "Honest limits",
        html: "polling a bounding box through credits gets expensive fast.",
      },
    ],
    best: "looking up a handful of known vessels, or satellite positions on demand.",
  },
  {
    name: "Datalastic",
    bullets: [
      {
        label: "Protocol",
        html: "REST with credits and a <a href='https://docs.datalastic.com/'>historical data API</a>; check the plan and date range for your project.",
      },
      {
        label: "Price",
        html: "Starter €199/month for 20,000 credits, Growth €569 for 80,000, Developer Pro €679 unlimited. Two-week money-back trial.",
      },
      {
        label: "License",
        html: "the terms ban exposing the data in a public-facing application.",
      },
      { label: "Honest limits", html: "no WebSocket, no public maps." },
    ],
    best: "a backend that needs history and is willing to pay for it.",
  },
  {
    name: "Kpler AIS (MarineTraffic, Spire Maritime, exactEarth, FleetMon)",
    intro:
      "The commercial layer consolidated into one company between 2021 and 2025.",
    bullets: [
      { label: "Protocol", html: "GraphQL, raw NMEA streams, Snowflake." },
      {
        label: "Coverage",
        html: "terrestrial and satellite coverage; confirm latency and coverage for your required area.",
      },
      {
        label: "Price",
        html: "contact sales for a quote matched to coverage, history, delivery, and usage rights.",
      },
      {
        label: "License",
        html: "no redistribution, no access through any third-party software or aggregator.",
      },
    ],
    best: "fleets and analysts evaluating contracted terrestrial and satellite data.",
  },
];

const glanceColumns = [
  "Push stream",
  "Historical data",
  "Coverage",
  "Free tier",
  "Redistribution",
  "Status page",
];
const glanceRows: [string, ...string[]][] = [
  [
    "Open Waters AIS",
    "yes, aisstream-compatible",
    "vessel tracks, subject to recorded coverage",
    "Nordic live, world via AISHub (~1 min behind), volunteers",
    "yes, no account",
    "yes, per-source license published",
    "yes",
  ],
  [
    "aisstream.io",
    "yes",
    "no",
    "global terrestrial, when up",
    "only tier",
    "confirm reuse terms",
    "no",
  ],
  [
    "AISHub",
    "no (≤1/min)",
    "current positions, not an archive",
    "worldwide terrestrial, ~1 min behind",
    "contributors only",
    "check AISHub terms",
    "no",
  ],
  [
    "Government feeds",
    "MQTT/TCP",
    "varies by agency and dataset",
    "Finland, Norway, EU inland",
    "yes",
    "yes",
    "per agency",
  ],
  [
    "VesselFinder",
    "quote",
    "historical datasets",
    "global + satellite",
    "no",
    "no",
    "no",
  ],
  [
    "Datalastic",
    "no",
    "historical API",
    "global",
    "trial",
    "no public display",
    "no",
  ],
  [
    "Kpler",
    "raw NMEA",
    "historical products; contact sales",
    "global + satellite",
    "no",
    "no",
    "enterprise",
  ],
];

const which: { when: string; then: string }[] = [
  {
    when: "Your aisstream client stopped and you want it back this afternoon:",
    then: "Open Waters AIS /v0/stream. One hostname.",
  },
  {
    when: "You run a receiver and want the world:",
    then: "AISHub offers aggregate access to qualifying receiver operators. Open Waters AIS contributes to that network and combines its coverage with other sources through streaming and snapshot APIs. You can contribute to both; choose the access that fits your project.",
  },
  {
    when: "Finland or Norway only:",
    then: "go direct to Digitraffic or Kystverket, or use Open Waters AIS for one protocol and the license carried through.",
  },
  {
    when: "A few known ships, occasionally:",
    then: "VesselFinder credits.",
  },
  {
    when: "Historical vessel movements or research:",
    then: "Start with Open Waters AIS vessel tracks and check the vessels and dates available. Compare Datalastic, VesselFinder, or government archives when you need a different region, time span, or delivery format.",
  },
  { when: "A fleet and a procurement department:", then: "Kpler." },
];

const faq = [
  {
    q: "Can I get historical AIS data from Open Waters AIS?",
    a: "Yes. The vessel-track REST endpoint returns recorded positions over a requested time range as GeoJSON or GPX. A request can span up to 366 days, but available history depends on the vessel and source. Check coverage for your dates; contact us about commercial historical analysis or bulk dataset needs.",
  },
  {
    q: "Is aisstream.io down?",
    a: "The status at the top of this page measures it live from a world-wide aisstream subscription we hold as one of our upstreams. If aisstream is delivering there but not to you, check your key, filters, and open connections: aisstream allows three subscribed connections per account and three open connections per IP, and stale connections have held accounts at that limit before.",
  },
  {
    q: "Is there a free alternative to aisstream.io?",
    a: "Open Waters AIS is free without an account and speaks the same protocol. AISHub is free if you run a receiver. The Finnish and Norwegian government feeds are free and open.",
  },
  {
    q: "Can I use aisstream.io data commercially?",
    a: "Confirm reuse terms with aisstream before building a commercial product on its feed. Open Waters AIS publishes source terms and attribution requirements; contact us about commercial access and any sources your product needs to exclude.",
  },
  {
    q: "Does Open Waters AIS have the same coverage as aisstream.io?",
    a: "Not yet in the same way. Open Waters AIS is live in Norway, Finland, and wherever volunteer receivers are, and carries worldwide terrestrial positions from AISHub that run about a minute behind. It also uses aisstream.io as an upstream when aisstream is up, but compare your actual vessels and regions before switching.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  url: `${SITE}/ais/alternatives/aisstream/`,
  publisher,
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<MainLayout
  title="Is aisstream.io down? Status, outages, and alternatives"
  image="/og/ais-alternatives-aisstream.png"
  description={DESCRIPTION}
  schema={faqSchema}
>
  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <a
        href="/ais/"
        class="text-accent hover:text-accent-hover mb-4 inline-flex items-center gap-1 text-sm font-medium"
      >
        <Icon name="mdi:arrow-left" class="size-4" />
        AIS
      </a>

      <h1 class="mb-2">Is aisstream.io down? Status and alternatives</h1>
      <p class="text-fg-faint mb-4 text-sm">
        aisstream outage record checked 11 October 2026; Open Waters AIS and
        aisstream documentation checked 8 October 2026; other provider details
        last checked 4 September 2026
      </p>

      <p class="text-lead mb-8">
        When an aisstream.io client goes quiet, the first question is whether
        aisstream is down or your connection is. This page answers it live, from
        a world-wide aisstream subscription we hold as one of our upstreams.
        Below that are aisstream's recent outages and the alternatives that keep
        a vessel feed running, starting with Open Waters AIS: an
        aisstream-compatible stream plus historical vessel tracks over REST.
      </p>

      <nav
        data-nosnippet
        aria-label="On this page"
        class="border-line bg-surface mb-12 rounded-lg border px-5 py-4 text-sm"
      >
        <span class="mr-2 font-semibold">On this page:</span>
        {sections.map((s, i) => (
          <>
            {i > 0 && <span class="text-fg-faint mx-2">·</span>}
            <a href={`#${s.id}`} class="text-accent hover:text-accent-hover">
              {s.label}
            </a>
          </>
        ))}
      </nav>

      <h2 id="status" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        Is aisstream.io down right now?
      </h2>
      <div
        id="as-status"
        data-nosnippet
        data-src={STATS}
        class="border-line bg-surface mb-4 rounded-lg border px-5 py-4"
      >
        <p class="mb-3 text-xl font-semibold" data-verdict>
          Checking aisstream.io…
        </p>
        <dl class="gap-y-2 text-sm">
          <dt>Last message</dt>
          <dd class="tabular-nums" data-stat="age">
            –
          </dd>
          <dt>Vessels, last 30 min</dt>
          <dd class="tabular-nums" data-stat="vessels">
            –
          </dd>
          <dt>Messages, last 24 h</dt>
          <dd class="tabular-nums" data-stat="events">
            –
          </dd>
        </dl>
      </div>
      <p class="text-fg-faint mb-12 text-sm">
        Measured from one world-wide aisstream subscription on one key, updated
        every 5 seconds from <a href={STATS}>/v1/stats</a>. A world-wide
        subscription normally hears something every few seconds, so five quiet
        minutes means aisstream has stopped delivering. If it is delivering here
        and not to you, the problem is more likely your key, filters, or
        connection count.
      </p>

      <h2 id="record" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        Outage record
      </h2>
      <dl class="mb-4 gap-y-3">
        {record.map((r) => (
          <>
            <dt class="pt-px">{r.when}</dt>
            <dd class="text-fg-muted" set:html={r.html} />
          </>
        ))}
      </dl>
      <p class="text-fg-muted mb-12">
        aisstream.io publishes no status page or uptime guarantee, and its{" "}
        <a
          href="https://github.com/aisstream/issues/issues"
          target="_blank"
          rel="noopener noreferrer"
        >
          issue tracker
        </a>{" "}
        had 211 open issues on 11 October 2026. By its own account it ran for
        nearly four years before these outages, and it remains one of our
        upstreams: when it delivers, Open Waters AIS carries its positions.
      </p>

      <h2 id="why" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        Why people look for an alternative
      </h2>
      <div class="text-fg-muted mb-12 space-y-4">
        <p>
          Most people arrive here because an aisstream client stopped receiving
          data. In the August outages, the connection opened and the
          subscription was accepted, then nothing arrived and no error frame was
          sent. From the client, that looks the same as a filter that matches no
          vessels.
        </p>
        <p>
          A live map or fleet monitor needs timely positions and a connection
          that says when it fails. Historical analysis needs recorded positions
          for specific vessels, places, and dates. A streaming API alone does
          not provide the past: your application must store the feed or use a
          provider with an archive.
        </p>
        <p>
          aisstream.io offers a free WebSocket feed. Its{" "}
          <a href="https://aisstream.io/documentation">current documentation</a>{" "}
          describes subscription confirmations and connection limits, but no
          durable replay or uptime guarantee. Look for an alternative when your
          project needs a stream that reports its own failures, historical
          queries, different coverage, or commercial terms.
        </p>
      </div>

      <h2 id="criteria" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        What to look for in a replacement
      </h2>
      <ul class="text-fg-muted mb-12 space-y-3">
        <li>
          <span class="font-semibold">Real-time tracking.</span> Decide whether
          you need a continuous stream or periodic REST lookups. Check position
          age, reconnect behaviour, and coverage for the vessels you follow.
        </li>
        <li>
          <span class="font-semibold">Historical analysis.</span> Check
          available dates, sampling, gaps, vessel identifiers, and export
          formats. A current position snapshot does not replace a historical
          track.
        </li>
        <li>
          <span class="font-semibold">Coverage you can see.</span> Terrestrial
          AIS reaches roughly 40 nautical miles from a receiver. Ask where the
          receivers are, and whether the service shows you per-station health so
          a gap is distinguishable from an outage.
        </li>
        <li>
          <span class="font-semibold">A license.</span> If you display, store,
          or redistribute the data, you need written terms. Most commercial APIs
          forbid public display or redistribution outright.
        </li>
        <li>
          <span class="font-semibold">Failure that announces itself.</span> An
          ack, a heartbeat, a close code, a status page.
        </li>
        <li>
          <span class="font-semibold">Someone to email.</span>
        </li>
      </ul>

      <h2 id="alternatives" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        The alternatives
      </h2>
      <div class="mb-6 space-y-6">
        {alternatives.map((a, i) => (
          <Card>
            <h3 class="mb-2 text-xl font-semibold">
              {i + 1}. {a.name}
            </h3>
            {a.intro && <p class="text-fg-muted mb-4">{a.intro}</p>}
            {/* The global dl style is a label | text grid: one scannable row per point. */}
            <dl class="gap-y-3">
              {a.bullets.map((b) => (
                <>
                  <dt class="pt-px">{b.label}</dt>
                  <dd class="text-fg-muted" set:html={b.html} />
                </>
              ))}
              <dt class="text-accent pt-px">Best for</dt>
              <dd>{a.best}</dd>
            </dl>
            {i === 0 && (
              <p class="mt-4 text-sm">
                <a href="/ais/vs/aisstream/">Field-by-field comparison</a> of
                Open Waters AIS and aisstream.io, or read the{" "}
                <a href="/api/ais/">API reference</a>.
              </p>
            )}
          </Card>
        ))}
      </div>
      <p class="text-fg-muted mb-12">
        Also seen: MyShipTracking (REST from €90/month, public or third-party
        use of the data prohibited) and Marinesia (the cheapest paid API found,
        about €14 a quarter as of August 2026, REST polling only, and the one
        service an aisstream user reported actually migrating to).
      </p>

      <h2 id="glance" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        At a glance
      </h2>
      <div class="mb-12 overflow-x-auto">
        <table class="w-full min-w-lg text-sm">
          <thead class="bg-surface">
            <tr>
              <th scope="col" class="px-3 py-2 text-left"></th>
              {glanceColumns.map((c) => (
                <th scope="col" class="px-3 py-2 text-left">
                  {c}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {glanceRows.map(([name, ...cells]) => (
              <tr>
                <th scope="row" class="px-3 py-2 text-left font-medium">
                  {name}
                </th>
                {cells.map((c) => (
                  <td class="text-fg-muted px-3 py-2">{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="which" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        Which one
      </h2>
      <ul class="text-fg-muted mb-12 space-y-3">
        {which.map((w) => (
          <li>
            <span class="font-semibold">{w.when}</span> {w.then}
          </li>
        ))}
      </ul>

      <h2 id="switch" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        Switching from aisstream.io to Open Waters AIS
      </h2>
      <ol class="text-fg-muted marker:text-fg-faint mb-6 list-decimal space-y-2 pl-5">
        <li>
          Get a personal token for personal use, or contact us for commercial
          access.
        </li>
        <li>
          Replace{" "}
          <code class="bg-surface rounded px-1">
            wss://stream.aisstream.io/v0/stream
          </code>{" "}
          with{" "}
          <code class="bg-surface rounded px-1">
            wss://ais.openwaters.io/v0/stream
          </code>
          .
        </li>
        <li>
          Put the token in <code class="bg-surface rounded px-1">APIKey</code>.
          The compatibility endpoint accepts:{" "}
          <code class="bg-surface rounded px-1">BoundingBoxes</code>,{" "}
          <code class="bg-surface rounded px-1">FiltersShipMMSI</code>,{" "}
          <code class="bg-surface rounded px-1">FilterMessageTypes</code>, and
          the <code class="bg-surface rounded px-1">MessageType</code> /{" "}
          <code class="bg-surface rounded px-1">MetaData</code> /
          <code class="bg-surface rounded px-1">Message</code> frame shape.
        </li>
      </ol>

      <div class="mb-6 grid gap-4 sm:grid-cols-2">
        <div>
          <p class="text-fg-faint mb-2 text-sm font-semibold">Before</p>
          <CodeBlock code="wss://stream.aisstream.io/v0/stream" />
        </div>
        <div>
          <p class="text-fg-faint mb-2 text-sm font-semibold">After</p>
          <CodeBlock code="wss://ais.openwaters.io/v0/stream" />
        </div>
      </div>

      <p class="mb-6">
        <a href="/ais/token/" class="btn btn-primary">
          Get a token
        </a>
      </p>

      <div class="text-fg-muted mb-12 space-y-4">
        <p>
          Check your client against both providers’ current limits and control
          messages before migrating. Open Waters AIS personal limits are per
          token (2 concurrent streams, 50 messages a second, about 20°×20°), so
          a world-sized bounding box is refused with a message that says so
          instead of silently throttled. Where aisstream's decoder was wrong (
          <code class="bg-surface rounded px-1">Valid: true</code> on
          out-of-range values, message 27 labelled 23),{" "}
          <code class="bg-surface rounded px-1">/v0</code> reproduces it on
          purpose so nothing breaks;{" "}
          <code class="bg-surface rounded px-1">/v1</code> gets it right. The
          full list is in the <a href="/api/ais/">API reference</a>.
        </p>
        <p>
          When you have a minute, move to{" "}
          <code class="bg-surface rounded px-1">/v1/stream</code>: no token for
          subscribing, one JSON event per message with{" "}
          <code class="bg-surface rounded px-1">source</code>,{" "}
          <code class="bg-surface rounded px-1">station</code>, the raw sentence
          and the decoded fields, an ack when your subscription is live, a
          heartbeat, and a close reason when we close.
        </p>
      </div>

      <h2 id="faq" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        FAQ
      </h2>
      <div class="space-y-6">
        {faq.map((item) => (
          <div>
            <h3 class="mb-1 font-semibold">{item.q}</h3>
            <p class="text-fg-muted">{item.a}</p>
          </div>
        ))}
      </div>
      <p class="text-fg-muted mt-8 text-sm">
        Questions, or a source we missed?{" "}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </Container>
</MainLayout>

<script>
  const root = document.getElementById("as-status");
  if (root) {
    // A world-wide subscription hears dozens of messages a second, so five quiet
    // minutes is an outage rather than a lull.
    const QUIET_S = 300;
    const src = root.dataset.src!;
    const verdict = root.querySelector("[data-verdict]")!;
    const ago = (s: number) =>
      s < 60
        ? `${s}s ago`
        : s < 3600
          ? `${Math.round(s / 60)}m ago`
          : `${Math.round(s / 3600)}h ago`;
    const show = (key: string, value: string) => {
      const el = root.querySelector(`[data-stat=${key}]`);
      if (el) el.textContent = value;
    };
    const poll = async () => {
      try {
        const a = (await (await fetch(src)).json()).sources.aisstream;
        if (!a) {
          verdict.textContent =
            "Down: aisstream.io has delivered nothing since our server last restarted.";
          return;
        }
        verdict.textContent =
          a.last_age_s < QUIET_S
            ? "Up: aisstream.io is delivering."
            : `Down: aisstream.io's last message was ${ago(a.last_age_s)}.`;
        show("age", ago(a.last_age_s));
        show("vessels", a.vessels.toLocaleString());
        show("events", a.events.last_24h.toLocaleString());
      } catch {
        verdict.textContent = "Live status is unavailable right now.";
      }
    };
    poll();
    setInterval(poll, 5000);
  }
</script>
