---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import Icon from "../../components/Icon.astro";
import AisMap from "../../components/ais/AisMap.astro";
import AisNav from "../../components/ais/AisNav.astro";
import AisStats from "../../components/ais/AisStats.astro";
import SectionDivider from "../../components/ui/SectionDivider.astro";
import { CONTACT_EMAIL } from "../../utils/constants";
import { SITE, faqPage, publisher } from "../../utils/schema";

const SERVER = "ais.openwaters.io";
const REPO = "https://github.com/openwatersio/aiscast";
const AGREEMENT = `${REPO}/blob/main/docs/contributor-agreement.md`;
const STATUS = "https://status.openwaters.io";

// Whether boaters get their own card is undecided. Flip to show it.
const BOATERS = false;
const uses = [
  {
    icon: "mdi:ferry",
    title: "Track your fleet",
    text: "Give us a list of MMSIs and every position report for those vessels arrives as JSON, with course, speed, heading, name, destination, and ETA. Free for a personal project.",
    link: { label: "Subscribe by MMSI", href: "/api/ais/#stream-v1" },
  },
  {
    icon: "mdi:vector-square",
    title: "Monitor your waters",
    text: "Draw a box around a port, a strait, or a stretch of coast and read everything inside it. One subscribe frame, no polling, no credits burned per query.",
    link: { label: "Subscribe by area", href: "/api/ais/#quick-start" },
  },
  {
    icon: "mdi:chart-timeline-variant",
    title: "Analyze marine activity",
    text: "Every event carries a timestamp, the station that heard it, and the source it came from. Log the stream and you own the dataset: transit counts, dwell times, traffic by hour, whatever you want to ask.",
    link: { label: "Event fields", href: "/api/ais/#stream-v1" },
  },
  ...(BOATERS
    ? [
        {
          icon: "mdi:sail-boat",
          title: "See beyond your antenna",
          text: "The Signal K plugin shows AIS traffic your own receiver cannot hear, on the chartplotter you already have. A supplement to onboard AIS, never a substitute, and not for safety of navigation.",
          link: {
            label: "Signal K plugin",
            href: "https://www.npmjs.com/package/signalk-aiscast",
          },
        },
      ]
    : []),
];

const open = [
  {
    icon: "mdi:lock-open-variant-outline",
    title: "Open access",
    text: "No account, no key, no receiver required. Open the WebSocket and read. Run a receiver and your limits go up.",
    link: { label: "Access and limits", href: "/api/ais/#limits" },
  },
  {
    icon: "mdi:open-source-initiative",
    title: "Open-source software",
    text: "The server is aiscast, MIT licensed. Read it, change it, run your own.",
    link: { label: "Source code", href: REPO },
  },
  {
    icon: "mdi:license",
    title: "Openly licensed contributions",
    text: "Volunteer receptions are dedicated CC0 and the volunteer aggregate is ODbL. Data shared under those licenses stays reusable under them. Partner data carries its own licenses, and source is on every event so you can attribute correctly.",
    link: { label: "Contributor agreement", href: AGREEMENT },
  },
];

const footer = [
  { label: "Live map", href: "/ais/vessels" },
  { label: "API docs", href: "/api/ais/" },
  { label: "Coverage and sources", href: "/ais/network" },
  { label: "Contributor agreement", href: AGREEMENT },
  { label: "Data licenses", href: "#license" },
  { label: "Privacy", href: "/ais/privacy/" },
  { label: "Status", href: STATUS },
  { label: "Source code", href: REPO },
  { label: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
];

// Network numbers polled from /v1/stats, plus uptime from the status page.
const vesselWindows = [
  { key: "vessels-1d", label: "24 hours" },
  { key: "vessels-7d", label: "7 days" },
  { key: "vessels-30d", label: "30 days" },
];
const health = [
  { key: "contributors", label: "Contributor stations" },
  { key: "latency", label: "Median latency" },
  { key: "uptime", label: "Uptime, 30 days" },
];

const licenses = [
  {
    source: "Kystverket",
    license: "NLOD 2.0",
    href: "https://data.norge.no/nlod/en/2.0",
    obligation:
      "Credit: “Contains data under the Norwegian licence for Open Government data (NLOD) distributed by the Norwegian Coastal Administration.” NLOD is not sublicensable: you are bound by it directly.",
  },
  {
    source: "BarentsWatch",
    license: "NLOD 2.0",
    href: "https://data.norge.no/nlod/en/2.0",
    obligation:
      "Credit: “Data delivered by BarentsWatch”. NLOD is not sublicensable: you are bound by it directly.",
  },
  {
    source: "Fintraffic Digitraffic",
    license: "CC BY 4.0",
    href: "https://creativecommons.org/licenses/by/4.0/",
    obligation:
      "Credit: “Source: Fintraffic / digitraffic.fi, license CC 4.0 BY.”",
  },
  {
    source: "Volunteer receivers",
    license: "CC0 1.0",
    href: "https://creativecommons.org/publicdomain/zero/1.0/",
    obligation:
      "Receptions are dedicated to the public domain under the contributor agreement; no attribution required. The aggregate database is published under ODbL.",
  },
  {
    source: "AISHub",
    license: "AISHub membership",
    href: "https://www.aishub.net/join-us",
    obligation:
      "AISHub has confirmed in writing that there are no restrictions on use, including commercial use and redistribution. Credit “AISHub” and carry it through if you redistribute; every event carries source: aishub.",
  },
  {
    source: "aisstream.io",
    license: "no published terms",
    obligation: "Best effort. source: aisstream.",
  },
];

// Rendered below and emitted as FAQPage. The questions are the ones people actually
// arrive with: what it costs, how the coverage compares, and how fresh the positions
// are. Nothing here promises uptime, because no tier below Custom carries an SLA.
const faq = [
  {
    q: "Is Open Waters AIS free?",
    a: "Reading is free with no account and no key. A free token raises the limits, and running a receiver raises them further. Products and fleets move to a paid plan; the plans and what each one lifts are on the pricing page.",
  },
  {
    q: "How does coverage compare to aisstream.io?",
    a: "Live terrestrial coverage is strongest in the Nordics and wherever our volunteer receivers are; elsewhere positions come from partner aggregates and are typically one to six minutes old. Open Waters AIS also reads aisstream.io as an upstream, so switching costs you no vessels.",
  },
  {
    q: "How fresh are the positions?",
    a: "Government feeds and volunteer receivers arrive as they are heard, within a second or two. Positions that only AISHub carries are a periodic snapshot rather than a live feed, however it looks, and run about a minute behind. The network page shows the current median latency per source.",
  },
  {
    q: "Do I need an account or an API key?",
    a: "No. Open the WebSocket and read. A token is one click in the browser with no account and no email, and it never expires.",
  },
  {
    q: "Can I switch from aisstream.io without rewriting my client?",
    a: "Yes. The /v0/stream endpoint speaks aisstream.io's protocol, so pointing an existing client at wss://ais.openwaters.io/v0/stream with your token as APIKey is the whole change.",
  },
  {
    q: "Can I use the data commercially?",
    a: "Yes, within each source's own licence. The aggregate is never relicensed, so every event names the source it came from and you carry that source's attribution through. The licence table on this page says what each one asks for.",
  },
];

// The graph below carries the context, so the FAQ node does not repeat it.
const { "@context": _faqContext, ...faqNode } = faqPage("/ais/", faq);

// A @graph so the page describes both the service and its questions. The Organization
// block that MainLayout emits on every page stays separate.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebAPI",
      name: "Open Waters AIS",
      url: `${SITE}/ais/`,
      description:
        "A real-time AIS network. Live ship positions from coastal authorities, partner aggregates, and volunteer receivers, streamed over WebSocket, SSE, and raw NMEA.",
      documentation: `${SITE}/api/ais/`,
      termsOfService: `${REPO}/blob/main/docs/policy.md`,
      provider: publisher,
      isAccessibleForFree: true,
      // No price here: the tiers and their numbers live on the pricing page.
      offers: { "@type": "Offer", url: `${SITE}/ais/pricing/` },
    },
    faqNode,
  ],
};
---

<MainLayout
  title="Open Waters AIS: free, real-time vessel data"
  image="/og/ais.png"
  description="Open Waters AIS is a free AIS network with an aisstream-compatible API, streaming live ship positions from coastal authorities and volunteer receivers."
  schema={schema}
>
  <!-- Hero: the live map runs full bleed under the header and fades into the page -->
  <section class="-mt-header relative overflow-hidden">
    <div class="absolute inset-0">
      <AisMap center={[23.6, 59.7]} zoom={6.3} class="h-full w-full" />
    </div>
    <div
      class="from-canvas/10 to-canvas pointer-events-none absolute inset-0 bg-linear-to-b via-transparent via-50%"
    >
    </div>
    <div
      class="bg-canvas/50 lg:from-canvas lg:via-canvas/30 pointer-events-none absolute inset-0 lg:bg-transparent lg:bg-linear-to-r lg:via-75% lg:to-transparent"
    >
    </div>
    <Container
      class="relative min-h-136 pt-36 pb-10 lg:min-h-160 lg:pt-44 lg:pb-12"
    >
      <div class="pointer-events-none max-w-2xl">
        <AisNav class="pointer-events-auto mb-6" />
        <h1 class="mb-6">
          The open <span class="text-highlight">AIS network.</span>
        </h1>
        <p class="text-lead mb-8 max-w-xl">
          Track ship traffic in real time, or contribute coverage from your
          receiver.
        </p>
      </div>
      <div
        class="pointer-events-auto flex flex-wrap items-center justify-between gap-x-10 gap-y-6"
      >
        <div class="flex flex-wrap gap-3">
          <a href="/api/ais/" class="btn btn-primary">
            Use the API
            <Icon name="mdi:arrow-right" class="size-4" />
          </a>
          <a href="/ais/contribute/" class="btn btn-secondary">Contribute</a>
          <a href="/ais/vessels" class="btn btn-secondary">
            <Icon name="mdi:map-outline" class="size-4" />
            Open the live map
          </a>
        </div>
        <AisStats statsUrl={`https://${SERVER}/v1/stats`} />
      </div>
    </Container>
  </section>

  <!-- What you can do -->
  <section class="py-8">
    <Container>
      <ul class="grid gap-5 md:grid-cols-3">
        {
          uses.map((u) => (
            <li class="card flex flex-col gap-3">
              <Icon name={u.icon} class="text-accent size-6" />
              <h2 class="text-lg font-semibold tracking-normal">{u.title}</h2>
              <p class="text-fg-muted text-sm">{u.text}</p>
              <a href={u.link.href} class="mt-auto text-sm font-medium">
                {u.link.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- The network today -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={1} total={3} label="Network" />
      <div
        class="mt-12 grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      >
        <div>
          <h2 class="mb-5">A network that grows with every receiver.</h2>
          <p class="text-fg-muted mb-6 text-lg">
            Government feeds, partner aggregates, and volunteer receivers all
            land in one deduplicated stream. Every station that joins adds
            vessels nobody else hears and fresher positions where the rest of
            the network is a minute behind.
          </p>
        </div>
        <a
          href="/ais/network"
          class="card-hover group text-fg block p-0 no-underline hover:no-underline"
        >
          <p class="px-6 pt-6 font-semibold">Unique Vessels</p>
          <div id="ais-network">
            <dl class="grid grid-cols-3 gap-4 px-6 pt-3 pb-6">
              {
                vesselWindows.map((n) => (
                  <div class="flex min-w-0 flex-col-reverse justify-end gap-1">
                    <dt class="text-fg-faint text-[11px] font-medium tracking-[0.12em] whitespace-nowrap uppercase">
                      <span class="sr-only">Unique vessels in the last </span>
                      {n.label}
                    </dt>
                    <dd class="text-fg-strong text-2xl font-semibold tracking-tight tabular-nums sm:text-4xl">
                      <span data-stat={n.key}>–</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
            <dl class="border-line grid grid-cols-3 gap-4 border-t px-6 py-5">
              {
                health.map((n) => (
                  <div class="flex min-w-0 flex-col-reverse justify-end gap-1">
                    <dt class="text-fg-faint text-[10px] font-medium tracking-[0.12em] uppercase">
                      {n.label}
                    </dt>
                    <dd class="text-fg-strong text-lg font-semibold tabular-nums">
                      <span data-stat={n.key}>–</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div
            class="border-line text-accent group-hover:text-accent-hover flex items-center justify-between gap-4 border-t px-6 py-4 text-sm font-medium"
          >
            <span>Sources, delays, and every station on the network page</span>
            <Icon
              name="mdi:arrow-right"
              class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
            />
          </div>
        </a>
      </div>
    </Container>
  </section>

  <!-- Two ways to participate -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={2} total={3} label="Participate" />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <div class="card flex flex-col gap-4 p-8">
          <h2 class="text-2xl">Use the data</h2>
          <p class="text-fg-muted text-lg">
            Open a WebSocket, send one subscribe frame, and the messages start
            arriving. There is a working example in five languages and nothing
            to sign up for first.
          </p>
          <p class="text-fg-faint text-sm">
            Talking to Claude or ChatGPT instead? Add{" "}
            <code class="text-fg-muted">https://{SERVER}/mcp</code> as an MCP server
            and <a href="/api/ais/#mcp">ask what is in the port</a>.
          </p>
          <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-3 pt-2">
            <a href="/api/ais/" class="btn btn-primary">Explore the APIs</a>
            <a href="/ais/pricing/" class="font-medium">View pricing →</a>
          </div>
        </div>
        <div id="contribute" class="card flex scroll-mt-24 flex-col gap-4 p-8">
          <h2 class="text-2xl">Contribute coverage</h2>
          <p class="text-fg-muted text-lg">
            Whatever your receiver hears joins the network, deduplicated against
            every other station, and you get the whole feed back. Add one output
            line to the software you already run; keep contributing everywhere
            else you contribute today.
          </p>
          <div class="mt-auto pt-2">
            <a href="/ais/contribute/" class="btn btn-secondary"
              >Connect your receiver</a
            >
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- What makes it open -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={3} total={3} label="Open" />
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          open.map((o) => (
            <li class="card flex flex-col gap-3">
              <Icon name={o.icon} class="text-accent size-6" />
              <h2 class="text-lg font-semibold tracking-normal">{o.title}</h2>
              <p class="text-fg-muted text-sm">{o.text}</p>
              <a href={o.link.href} class="mt-auto text-sm font-medium">
                {o.link.label} →
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-16 max-w-2xl">
        <h3 id="license" class="mb-4 scroll-mt-24">License</h3>
        <p class="text-fg-muted">
          Licensing is per source, and the aggregate is not relicensed: each
          event is re-served under the terms of the source it came from, which
          is why <code class="text-fg">source</code> is on every event and every vessel.
          If you display or redistribute the data, carry the source's attribution
          through.
        </p>
      </div>
      <div class="border-line mt-8 overflow-x-auto rounded-2xl border">
        <table class="w-full min-w-lg text-sm">
          <thead
            class="border-line bg-surface text-fg-faint border-b text-[11px] font-medium tracking-[0.12em] uppercase"
          >
            <tr>
              <th scope="col" class="px-4 py-3 text-left font-medium">Source</th
              >
              <th scope="col" class="px-4 py-3 text-left font-medium"
                >License</th
              >
              <th scope="col" class="px-4 py-3 text-left font-medium"
                >What you must do</th
              >
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {
              licenses.map((row) => (
                <tr>
                  <td class="text-fg-strong px-4 py-3 font-medium">
                    {row.source}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    {row.href ? (
                      <a
                        href={row.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {row.license}
                      </a>
                    ) : (
                      row.license
                    )}
                  </td>
                  <td class="text-fg-muted px-4 py-3">{row.obligation}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-fg-faint mt-6 text-sm">
        The server, viewer, and plugin are{" "}
        <a
          href={`${REPO}/blob/main/LICENSE`}
          target="_blank"
          rel="noopener noreferrer">MIT</a
        >. The full position on licensing, privacy, and how the project funds
        itself without relicensing data is in the <a
          href={`${REPO}/blob/main/docs/policy.md`}
          target="_blank"
          rel="noopener noreferrer">data policy</a
        >.
      </p>
    </Container>
  </section>

  <!-- Questions. The text matches the FAQPage schema above; keep them in step. -->
  <section class="py-16 lg:py-24">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 id="faq" class="mb-10 scroll-mt-24">Questions</h2>
        {
          /* Not a <dl>: global.css lays every definition list out as a two-column
            term grid, and a question is a heading rather than a term. */
        }
        <div class="divide-line divide-y">
          {
            faq.map((item) => (
              <div class="py-6 first:pt-0">
                <h3 class="text-fg-strong mb-2 text-lg font-semibold">
                  {item.q}
                </h3>
                <p class="text-fg-muted">{item.a}</p>
              </div>
            ))
          }
        </div>
        <p class="text-fg-faint mt-8 text-sm">
          Something else? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
          >.
        </p>
      </div>
    </Container>
  </section>

  <!-- Closing call -->
  <section class="pb-24">
    <Container>
      <div
        class="card flex flex-col gap-6 p-8 md:flex-row md:items-center md:justify-between md:p-12"
      >
        <div>
          <h2 class="mb-2">Track ship traffic, or help others see it.</h2>
          <p class="text-fg-muted text-lg">
            No account to read. One output line to contribute.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="/api/ais/" class="btn btn-primary">Use the data</a>
          <a href="/ais/contribute/" class="btn btn-secondary">Contribute</a>
        </div>
      </div>
      <p
        class="text-fg-faint mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm"
        data-nosnippet
      >
        {
          footer.map((f, i) => (
            <>
              {i > 0 && " · "}
              <a href={f.href}>{f.label}</a>
            </>
          ))
        }
      </p>
    </Container>
  </section>
</MainLayout>

<script>
  // Volunteer receivers, as opposed to government feeds and partner aggregates.
  const CONTRIBUTOR_SOURCES = ["station", "udp", "http", "v1", "mmsi"];

  const fmt = (n: number) => Math.round(n).toLocaleString();
  const text = (root: HTMLElement | null, values: Record<string, string>) => {
    if (!root) return;
    for (const [key, value] of Object.entries(values)) {
      const el = root.querySelector(`[data-stat="${key}"]`);
      if (el && value) el.textContent = value;
    }
  };
  const fill = (root: HTMLElement | null, values: Record<string, number>) => {
    if (!root) return;
    for (const [key, value] of Object.entries(values)) {
      const el = root.querySelector(`[data-stat="${key}"]`);
      if (el && Number.isFinite(value)) el.textContent = fmt(value);
    }
  };

  const hero = document.getElementById("ais-stats");
  const network = document.getElementById("ais-network");
  const src = hero?.dataset.src;
  if (src) {
    const poll = async () => {
      try {
        const res = await fetch(src);
        if (!res.ok) return;
        const s = await res.json();
        fill(hero, {
          stations: s.stations.active,
          vessels: s.vessels.active ?? s.vessels.total,
          rate: s.events.per_second,
        });
        const sources = Object.values(
          (s.sources ?? {}) as Record<
            string,
            { delay?: { p50: number }; events: { last_24h: number } }
          >,
        ).filter((v) => v.delay && v.events.last_24h);
        const weight = sources.reduce((n, v) => n + v.events.last_24h, 0);
        fill(network, {
          "vessels-1d": s.vessels.last_24h,
          "vessels-7d": s.vessels.last_7d,
          "vessels-30d": s.vessels.last_30d,
          contributors: Object.entries(
            (s.stations.by_source ?? {}) as Record<string, number>,
          ).reduce(
            (n, [k, v]) => (CONTRIBUTOR_SOURCES.includes(k) ? n + v : n),
            0,
          ),
        });
        text(network, {
          // Each source's median, weighted by how many messages it delivers.
          latency: weight
            ? `${(sources.reduce((n, v) => n + v.delay!.p50 * v.events.last_24h, 0) / weight).toFixed(1)} s`
            : "",
        });
      } catch {
        // leave the placeholders; the page works without numbers
      }
    };
    poll();
    setInterval(poll, 5000);
  }

  // Uptime of the AIS stream monitor on status.openwaters.io (Upptime).
  if (network) {
    fetch(
      "https://raw.githubusercontent.com/openwatersio/status/master/history/summary.json",
    )
      .then((res) => (res.ok ? res.json() : []))
      .then((monitors: { slug: string; uptimeMonth?: string }[]) => {
        const month = parseFloat(
          monitors.find((m) => m.slug === "ais-stream")?.uptimeMonth ?? "",
        );
        if (Number.isFinite(month))
          text(network, { uptime: `${+month.toFixed(2)}%` });
      })
      .catch(() => {});
  }
</script>
