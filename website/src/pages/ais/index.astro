---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import Card from "../../components/ui/Card.astro";
import CodeBlock from "../../components/ui/CodeBlock.astro";
import Icon from "../../components/Icon.astro";
import AisMap from "../../components/ais/AisMap.astro";
import AisTicker from "../../components/ais/AisTicker.astro";
import SectionDivider from "../../components/ui/SectionDivider.astro";
import { CONTACT_EMAIL } from "../../utils/constants";
import { highlight, SNIPPET_LANGS } from "../../utils/shiki";

const SERVER = "ais.openwaters.io";
const REPO = "https://github.com/openwatersio/aiscast";
const TOKEN_PAGE = "/ais/token/";

const bbox = "59,10,60,11";
const snippets: {
  id: string;
  label: string;
  lang: (typeof SNIPPET_LANGS)[number];
  code: string;
}[] = [
  {
    id: "js",
    label: "JavaScript",
    lang: "js",
    code: `const ws = new WebSocket("wss://${SERVER}/v1/stream");
ws.onopen = () =>
  ws.send(JSON.stringify({
    type: "subscribe",
    bbox: [[59, 10, 60, 11]]
  }));
ws.onmessage = ({ data }) => {
  const ev = JSON.parse(data);
  if (ev.type !== "event") return; // welcome, ack, error
  console.log(ev.mmsi, ev.msg_type, ev.lat, ev.lon);
};`,
  },
  {
    id: "python",
    label: "Python",
    lang: "python",
    code: `import asyncio, json, websockets

URL = "wss://${SERVER}/v1/stream"
SUB = {"type": "subscribe", "bbox": [[59, 10, 60, 11]]}

async def main():
    async with websockets.connect(URL) as ws:
        await ws.send(json.dumps(SUB))
        async for frame in ws:
            ev = json.loads(frame)
            if ev["type"] != "event":  # welcome, ack, error
                continue
            print(ev["mmsi"], ev["msg_type"],
                  ev.get("lat"), ev.get("lon"))

asyncio.run(main())`,
  },
  {
    id: "go",
    label: "Go",
    lang: "go",
    code: `url := "wss://${SERVER}/v1/stream"
c, _, err := websocket.DefaultDialer.Dial(url, nil)
if err != nil {
	log.Fatal(err)
}
c.WriteJSON(map[string]any{
	"type": "subscribe",
	"bbox": [][]float64{{59, 10, 60, 11}},
})
for {
	var ev struct {
		Type    string  \`json:"type"\`
		MMSI    int     \`json:"mmsi"\`
		MsgType string  \`json:"msg_type"\`
		Lat     float64 \`json:"lat"\`
		Lon     float64 \`json:"lon"\`
	}
	if err := c.ReadJSON(&ev); err != nil {
		log.Fatal(err)
	}
	if ev.Type != "event" { // welcome, ack, error
		continue
	}
	fmt.Println(ev.MMSI, ev.MsgType, ev.Lat, ev.Lon)
}`,
  },
  {
    id: "rust",
    label: "Rust",
    lang: "rust",
    code: `use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::{connect_async, tungstenite::Message};

#[tokio::main]
async fn main() {
    let url = "wss://${SERVER}/v1/stream";
    let (mut ws, _) = connect_async(url).await.unwrap();
    let sub = r#"{"type":"subscribe","bbox":[[59,10,60,11]]}"#;
    ws.send(Message::text(sub)).await.unwrap();
    while let Some(Ok(msg)) = ws.next().await {
        let Message::Text(frame) = msg else { continue };
        let ev: serde_json::Value =
            serde_json::from_str(&frame).unwrap();
        if ev["type"] != "event" { continue } // welcome, ack, error
        println!("{} {} {} {}",
            ev["mmsi"], ev["msg_type"], ev["lat"], ev["lon"]);
    }
}`,
  },
  {
    id: "shell",
    label: "Shell",
    lang: "sh",
    code: `# live stream
SUB='{"type":"subscribe","bbox":[[59,10,60,11]]}'
echo "$SUB" | websocat -n wss://${SERVER}/v1/stream

# snapshot of what is in the box right now
curl "https://${SERVER}/v1/vessels?bbox=${bbox}"`,
  },
];
const highlighted = await Promise.all(
  snippets.map((s) => highlight(s.code, s.lang)),
);

const tiers = [
  {
    name: "Anonymous",
    text: "For trying things out.",
  },
  {
    name: "Personal",
    text: "For a boat, a hobby project, or a developer’s laptop.",
    cta: { label: "Get a token", href: TOKEN_PAGE, primary: true },
  },
  {
    name: "Contributor",
    text: "Awarded to a station that contributes data.",
    cta: { label: "Start contributing", href: "#contribute" },
  },
  {
    name: "Commercial",
    text: "For products, fleets, or those who need support.",
    cta: {
      label: "Contact us",
      href: `mailto:${CONTACT_EMAIL}`,
    },
  },
];
// one cell per tier: true/false for a check, or a string
const rows: [string, ...(boolean | string)[]][] = [
  ["Cost", "Free", "Free", "Free", "Paid"],
  ["Connections/IP Address", "2", "2", "5", "10 or more"],
  ["Messages/sec", "20", "50", "200", "Unlimited"],
  ["Subscribed area", "~10°×10°", "~20°×20°", "Unlimited", "Unlimited"],
  ["Vessels followed by MMSI", "10", "50", "200", "As agreed"],
  ["Sending data", false, true, true, true],
  ["Raw NMEA feed", false, false, true, true],
];

const contribute = [
  {
    icon: "mdi:radio-tower",
    title: "AIS-catcher",
    text: "Authenticated HTTP, works behind any NAT. Get a token in your browser, add one flag.",
    code: `AIS-catcher -H https://${SERVER}/v1/receive USERPWD x:<token> GZIP on INTERVAL 15`,
    links: [
      { label: "Get a token", href: TOKEN_PAGE },
      {
        label: "AIS-catcher",
        href: "https://github.com/jvde-github/AIS-catcher",
      },
    ],
  },
  {
    icon: "mdi:sail-boat",
    title: "Signal K",
    text: "One plugin, both directions: shares what your receiver hears and shows AIS traffic when it hears none. No account; it creates its own token.",
    code: "npm install signalk-aiscast",
    links: [
      { label: "npm", href: "https://www.npmjs.com/package/signalk-aiscast" },
      { label: "README", href: `${REPO}/tree/main/signalk-plugin#readme` },
    ],
  },
  {
    icon: "mdi:docker",
    title: "docker-shipfeeder",
    text: "Already sending to the aggregators from a container? Add one more UDP destination.",
    code: `host ${SERVER}, port 10110`,
    links: [
      {
        label: "docker-shipfeeder",
        href: "https://github.com/sdr-enthusiasts/docker-shipfeeder",
      },
    ],
  },
  {
    icon: "mdi:lan-connect",
    title: "Any NMEA forwarder",
    text: "Plain !AIVDM sentences over UDP, no token. Your station is a keyed hash of your address, never the address itself.",
    code: `AIS-catcher -u ${SERVER} 10110`,
    links: [
      {
        label: "ais-forwarder",
        href: "https://github.com/hkapanen/ais-forwarder",
      },
    ],
  },
];

// Live numbers come from /v1/stats; `ids` are the `source` prefixes each row sums.
const sources = [
  {
    name: "Kystverket",
    ids: ["kystverket"],
    where: "Norwegian coast, 40–60 nm out",
  },
  {
    name: "BarentsWatch",
    ids: ["barentswatch"],
    where: "Norwegian EEZ and Svalbard, incl. satellite",
  },
  {
    name: "Fintraffic Digitraffic",
    ids: ["digitraffic"],
    where: "Finnish waters",
  },
  {
    name: "Volunteer receivers",
    ids: ["udp", "http", "v1", "mmsi"],
    where: "Global, wherever they are",
  },
  {
    name: "AISHub",
    ids: ["aishub"],
    where: "worldwide terrestrial; ~5 min snapshots",
  },
  {
    name: "aisstream.io",
    ids: ["aisstream"],
    where: "worldwide (when it is up)",
  },
];

const licenses = [
  {
    source: "Kystverket",
    license: "NLOD 2.0",
    href: "https://data.norge.no/nlod/en/2.0",
    obligation:
      "Credit: “Contains data under the Norwegian licence for Open Government data (NLOD) distributed by the Norwegian Coastal Administration.” NLOD is not sublicensable: you are bound by it directly.",
  },
  {
    source: "BarentsWatch",
    license: "NLOD 2.0",
    href: "https://data.norge.no/nlod/en/2.0",
    obligation:
      "Credit: “Data delivered by BarentsWatch”. NLOD is not sublicensable: you are bound by it directly.",
  },
  {
    source: "Fintraffic Digitraffic",
    license: "CC BY 4.0",
    href: "https://creativecommons.org/licenses/by/4.0/",
    obligation:
      "Credit: “Source: Fintraffic / digitraffic.fi, license CC 4.0 BY.”",
  },
  {
    source: "Volunteer receivers",
    license: "CC0 1.0",
    href: "https://creativecommons.org/publicdomain/zero/1.0/",
    obligation:
      "Receptions are dedicated to the public domain under the contributor agreement; no attribution required. The aggregate database is published under ODbL.",
  },
  {
    source: "AISHub",
    license: "AISHub membership",
    href: "https://www.aishub.net/join-us",
    obligation:
      "AISHub has confirmed in writing that there are no restrictions on use, including commercial use and redistribution. Credit “AISHub” and carry it through if you redistribute; every event carries source: aishub.",
  },
  {
    source: "aisstream.io",
    license: "no published terms",
    obligation: "Best effort, frequently offline. source: aisstream.",
  },
];
---

<MainLayout
  title="aiscast: an open AIS network, streamed in real time"
  image="/og/ais.png"
  description="aiscast is the Open Waters AIS network: live ship positions from coastal authorities and volunteer receivers, streamed in real time. Open source and free for personal use."
>
  <!-- Hero: the live map runs full bleed under the header and fades into the page -->
  <section class="-mt-header relative overflow-hidden">
    <div class="absolute inset-0">
      <AisMap center={[23.6, 59.7]} zoom={6.3} class="h-full w-full" />
    </div>
    <div
      class="from-canvas/60 to-canvas pointer-events-none absolute inset-0 bg-linear-to-b via-transparent via-25%"
    >
    </div>
    <div
      class="bg-canvas/70 lg:from-canvas lg:via-canvas/30 pointer-events-none absolute inset-0 lg:bg-transparent lg:bg-linear-to-r lg:via-40% lg:to-transparent"
    >
    </div>
    <Container class="relative pt-36 pb-24 lg:pt-44 lg:pb-28">
      <div
        class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)]"
      >
        <div class="pointer-events-none max-w-2xl">
          <p class="eyebrow mb-6">aiscast · the Open Waters AIS network</p>
          <h1 class="mb-6">
            All the ships at sea,<br />
            <span class="text-highlight">instantaneously.</span>
          </h1>
          <p class="text-lead mb-8 max-w-xl">
            A real-time stream of marine AIS traffic. Open source, and free for
            personal use.
          </p>
          <div class="pointer-events-auto flex flex-wrap gap-3">
            <a href="/api/ais/" class="btn btn-primary">
              Read the API docs
              <Icon name="mdi:arrow-right" class="size-4" />
            </a>
            <a href={TOKEN_PAGE} class="btn btn-secondary">Get a token</a>
          </div>
        </div>
        <AisTicker statsUrl={`https://${SERVER}/v1/stats`} />
      </div>
    </Container>
  </section>

  <!-- Why -->
  <section class="py-8">
    <Container>
      <ul class="grid gap-5 md:grid-cols-3">
        {
          [
            {
              icon: "mdi:broadcast",
              title: "Real-time API",
              text: "Get every AIS message as it is heard over WebSocket, SSE, or NMEA. Fetch a GeoJSON snapshot of what is in a box right now, plus stations and live stats.",
              link: { label: "API reference", href: "/api/ais/" },
            },
            {
              icon: "mdi:open-source-initiative",
              title: "Open source, open data",
              text: "An open AIS network powered by MIT-licensed code, and data re-served under each source's own terms, with the source named on every event.",
              link: { label: "GitHub", href: REPO },
            },
            {
              icon: "mdi:hand-heart-outline",
              title: "Free for personal use",
              text: "Read without an account; a one-click token covers a boat, a dashboard, or a side project. Contributing AIS data earns more.",
              link: { label: "See tiers and limits", href: "#limits" },
            },
          ].map((w) => (
            <li class="card flex flex-col gap-3">
              <Icon name={w.icon} class="text-accent size-6" />
              <h2 class="text-lg font-semibold tracking-normal">{w.title}</h2>
              <p class="text-fg-muted text-sm">{w.text}</p>
              <a href={w.link.href} class="mt-auto text-sm font-medium">
                {w.link.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- Stream -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={1} total={4} label="Stream" />
      <div
        class="mt-12 grid items-start gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      >
        <div>
          <h2 class="mb-5">Stream vessel data in your favorite language.</h2>
          <p class="text-fg-muted mb-6 text-lg">
            Open a WebSocket, send one subscribe frame, and every message inside
            the box arrives as JSON with its source, station, raw sentence, and
            decoded fields.
          </p>
          <div class="mb-6 flex flex-wrap gap-x-6 gap-y-2 font-medium">
            <a href="/api/ais/">API reference →</a>
            <a href="/ais/vs/aisstream/">Compare with aisstream.io →</a>
          </div>
          <p class="text-fg-faint text-sm">
            Coming from aisstream.io? Point your client at{" "}
            <code class="text-fg-muted">wss://{SERVER}/v0/stream</code> with a token
            as <code class="text-fg-muted">APIKey</code> and it keeps working.
          </p>
        </div>
        <div
          data-tabs
          class="border-line bg-well overflow-hidden rounded-2xl border"
        >
          <div
            role="tablist"
            aria-label="Language"
            class="border-line flex gap-1 overflow-x-auto border-b p-2"
          >
            {
              snippets.map((s, i) => (
                <button
                  id={`tab-${s.id}`}
                  role="tab"
                  type="button"
                  aria-selected={i === 0}
                  tabindex={i === 0 ? 0 : -1}
                  aria-controls={`snippet-${s.id}`}
                  class="text-fg-muted hover:text-fg-strong aria-selected:bg-surface-raised aria-selected:text-fg-strong rounded-lg px-3 py-1.5 text-sm font-medium"
                >
                  {s.label}
                </button>
              ))
            }
          </div>
          {
            snippets.map((s, i) => (
              <div
                role="tabpanel"
                id={`snippet-${s.id}`}
                aria-labelledby={`tab-${s.id}`}
                tabindex="0"
                hidden={i !== 0}
              >
                <Fragment set:html={highlighted[i]} />
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Tiers -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={2} total={4} label="Tiers" id="limits" />
      <div class="mt-12 max-w-2xl">
        <h2 class="mb-5">Limits, but only to keep the lights on.</h2>
        <p class="text-fg-muted text-lg">
          Everything re-served here is open data or volunteer data its
          contributor chose to share. These limits exist to keep the service
          healthy and reward the people who contribute to it.
        </p>
      </div>
      <div class="border-line mt-10 overflow-x-auto rounded-2xl border">
        <table class="w-full min-w-2xl table-fixed text-sm">
          <thead>
            <tr class="border-line bg-surface border-b">
              <th class="w-48"></th>
              {
                tiers.map((t) => (
                  <th
                    scope="col"
                    class="text-fg-strong px-4 py-4 text-left align-top font-semibold"
                  >
                    {t.name}
                    <span class="text-fg-muted mt-1 block text-xs font-normal">
                      {t.text}
                    </span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {
              rows.map(([feature, ...cells]) => (
                <tr>
                  <th
                    scope="row"
                    class="text-fg-muted px-4 py-3 text-left font-normal"
                  >
                    {feature}
                  </th>
                  {cells.map((c) => (
                    <td class="px-4 py-3 font-mono text-xs">
                      {c === true ? (
                        <Icon
                          name="mdi:check"
                          class="text-accent inline size-4"
                        />
                      ) : c === false ? (
                        <span class="text-fg-faint">—</span>
                      ) : (
                        c
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <td></td>
              {
                tiers.map((t) => (
                  <td class="px-4 py-5">
                    {t.cta && (
                      <a
                        href={t.cta.href}
                        class:list={[
                          "btn btn-sm",
                          t.cta.primary ? "btn-primary" : "btn-secondary",
                        ]}
                      >
                        {t.cta.label}
                      </a>
                    )}
                  </td>
                ))
              }
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="text-fg-faint mt-6 max-w-3xl text-sm">
        Limits apply per token and per network address: at most 8 concurrent
        streams from one address, however many tokens are behind it. Over a
        per-second rate the stream thins and stays up; over a connection, area,
        or MMSI-list limit you are refused with a message that says so.
        Following vessels by MMSI is bounded by the list, not by area, so a
        world-wide MMSI subscription is allowed in every tier. Need more, or
        unsure which tier you are? <a href={`mailto:${CONTACT_EMAIL}`}
          >{CONTACT_EMAIL}</a
        >.
      </p>
    </Container>
  </section>

  <!-- Contribute -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={3} total={4} label="Contribute" id="contribute" />
      <div
        class="mt-12 grid items-start gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      >
        <div>
          <h2 class="mb-5">Put your receiver on the map.</h2>
          <p class="text-fg-muted mb-6 text-lg">
            Whatever your antenna hears is re-served to everyone, and
            deduplicated against every other station. Contribute 1,000 messages
            a day and your token moves to the Contributor tier on its own.
          </p>
          <p class="text-fg-faint text-sm">
            Watch your station arrive at <code class="text-fg-muted"
              >GET /v1/stations</code
            >. Named stations with higher limits, and anything else: <a
              href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
            >. Developers: <a
              href={`${REPO}/blob/main/CONTRIBUTING.md`}
              target="_blank"
              rel="noopener noreferrer">CONTRIBUTING.md</a
            >.
          </p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {
            contribute.map((c) => (
              <Card class="flex min-w-0 flex-col gap-3">
                <div class="flex items-center gap-3">
                  <Icon name={c.icon} class="text-accent size-6" />
                  <h3 class="text-lg font-semibold tracking-normal">
                    {c.title}
                  </h3>
                </div>
                <p class="text-fg-muted text-sm">{c.text}</p>
                <CodeBlock class="text-xs" code={c.code} />
                <div class="mt-auto flex flex-wrap gap-4 text-sm font-medium">
                  {c.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer">
                      {l.label}
                    </a>
                  ))}
                </div>
              </Card>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Sources and license -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionDivider index={4} total={4} label="Sources" id="sources" />
      <div
        class="mt-12 grid items-start gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      >
        <div>
          <h2 class="mb-5">Every event names its source.</h2>
          <p class="text-fg-muted text-lg">
            Vessels are distinct MMSIs heard in the last 30 minutes;
            <em>unique</em> counts the ones no other source heard.
          </p>
        </div>
        <div class="border-line overflow-x-auto rounded-2xl border">
          <table id="ais-sources" class="w-full min-w-lg text-sm">
            <thead
              class="eyebrow border-line bg-surface text-fg-faint border-b text-[10px]"
            >
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-medium"
                  >Source</th
                >
                <th scope="col" class="px-4 py-3 text-right font-medium"
                  >Vessels</th
                >
                <th scope="col" class="px-4 py-3 text-right font-medium"
                  >Unique</th
                >
                <th scope="col" class="px-4 py-3 text-right font-medium"
                  >Events / 24h</th
                >
                <th scope="col" class="px-4 py-3 text-right font-medium"
                  >Last heard</th
                >
              </tr>
            </thead>
            <tbody class="divide-line divide-y">
              {
                sources.map((row) => (
                  <tr data-ids={row.ids.join(",")}>
                    <td class="px-4 py-3">
                      <span class="text-fg-strong font-medium">{row.name}</span>
                      <span class="text-fg-faint block text-xs">
                        {row.where}
                      </span>
                    </td>
                    <td
                      class="px-4 py-3 text-right font-mono text-xs"
                      data-stat="vessels"
                    >
                      –
                    </td>
                    <td
                      class="px-4 py-3 text-right font-mono text-xs"
                      data-stat="exclusive"
                    >
                      –
                    </td>
                    <td
                      class="px-4 py-3 text-right font-mono text-xs"
                      data-stat="events"
                    >
                      –
                    </td>
                    <td
                      class="text-fg-muted px-4 py-3 text-right font-mono text-xs"
                      data-stat="age"
                    >
                      –
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-16 max-w-2xl">
        <h3 id="license" class="mb-4 scroll-mt-24">License</h3>
        <p class="text-fg-muted">
          Licensing is per source, and the aggregate is not relicensed: each
          event is re-served under the terms of the source it came from, which
          is why <code class="text-fg">source</code> is on every event and every vessel.
          If you display or redistribute the data, carry the source's attribution
          through.
        </p>
      </div>
      <div class="border-line mt-8 overflow-x-auto rounded-2xl border">
        <table class="w-full min-w-lg text-sm">
          <thead
            class="eyebrow border-line bg-surface text-fg-faint border-b text-[10px]"
          >
            <tr>
              <th scope="col" class="px-4 py-3 text-left font-medium">Source</th
              >
              <th scope="col" class="px-4 py-3 text-left font-medium"
                >License</th
              >
              <th scope="col" class="px-4 py-3 text-left font-medium"
                >What you must do</th
              >
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {
              licenses.map((row) => (
                <tr>
                  <td class="text-fg-strong px-4 py-3 font-medium">
                    {row.source}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    {row.href ? (
                      <a
                        href={row.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {row.license}
                      </a>
                    ) : (
                      row.license
                    )}
                  </td>
                  <td class="text-fg-muted px-4 py-3">{row.obligation}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-fg-faint mt-6 text-sm">
        The server, viewer, and plugin are{" "}
        <a
          href={`${REPO}/blob/main/LICENSE`}
          target="_blank"
          rel="noopener noreferrer">MIT</a
        >. The full position on licensing, privacy, and how the project funds
        itself without relicensing data is in the <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer">GitHub repository</a
        >.
      </p>
    </Container>
  </section>

  <!-- Closing call -->
  <section class="pb-24">
    <Container>
      <div
        class="card flex flex-col gap-6 p-8 md:flex-row md:items-center md:justify-between md:p-12"
      >
        <div>
          <h2 class="mb-2">Start with one WebSocket.</h2>
          <p class="text-fg-muted text-lg">
            No account, no key. Get a token later if you outgrow the anonymous
            limits.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="/api/ais/" class="btn btn-primary">Read the API docs</a>
          <a href={TOKEN_PAGE} class="btn btn-secondary">Get a token</a>
        </div>
      </div>
    </Container>
  </section>
</MainLayout>

<script>
  // Snippet tabs: click or arrow keys
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      tabs[i]!.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) select((i + d + tabs.length) % tabs.length);
      });
    });
  });

  // Sources table: each row sums the /v1/stats sources whose prefix (before ":") is in its data-ids.
  // Summed vessels can double count one heard by two of a row's stations; close enough for a summary.
  const ago = (s: number) =>
    s < 60
      ? `${s}s ago`
      : s < 3600
        ? `${Math.round(s / 60)}m ago`
        : `${Math.round(s / 3600)}h ago`;
  const fillSources = (
    sources: Record<
      string,
      {
        events: { last_24h: number };
        last_age_s: number;
        vessels: number;
        vessels_exclusive: number;
      }
    >,
  ) => {
    const rows = [
      ...document.querySelectorAll<HTMLElement>("#ais-sources tr[data-ids]"),
    ].map((tr) => {
      const ids = tr.dataset.ids!.split(",");
      const mine = Object.entries(sources).filter(([k]) =>
        ids.includes(k.split(":")[0]!),
      );
      if (!mine.length) return { tr, exclusive: -1 };
      const sum = (f: (v: (typeof mine)[number][1]) => number) =>
        mine.reduce((n, [, v]) => n + f(v), 0);
      const set = (k: string, v: string) =>
        (tr.querySelector(`[data-stat=${k}]`)!.textContent = v);
      const exclusive = sum((v) => v.vessels_exclusive);
      set("vessels", sum((v) => v.vessels).toLocaleString());
      set("exclusive", exclusive.toLocaleString());
      set("events", sum((v) => v.events.last_24h).toLocaleString());
      set("age", ago(Math.min(...mine.map(([, v]) => v.last_age_s))));
      return { tr, exclusive };
    });
    rows
      .sort((a, b) => b.exclusive - a.exclusive)
      .forEach(({ tr }) => tr.parentElement!.appendChild(tr));
  };

  // Live stats: active stations, vessels in the cache, deduplicated events/sec.
  const stats = document.getElementById("ais-stats");
  if (stats) {
    const src = stats.dataset.src!;
    const show = (key: string, value: number | string) => {
      stats.querySelector(`[data-stat=${key}]`)!.textContent =
        typeof value === "number" ? Math.round(value).toLocaleString() : value;
    };
    const poll = async () => {
      try {
        const s = await (await fetch(src)).json();
        show("stations", s.stations.active);
        show("vessels", s.vessels.total);
        show("rate", s.events.per_second);
        fillSources(s.sources);
      } catch {
        // leave the placeholders; the hero works without numbers
      }
    };
    poll();
    setInterval(poll, 5000);
  }
</script>
