---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import Card from "../../components/ui/Card.astro";
import Icon from "../../components/Icon.astro";
import { CONTACT_EMAIL } from "../../utils/constants";

const SERVER = "https://ais.openwaters.io";
// The GitHub Pages viewer still redirects here, preserving the query and the old hash,
// so links volunteers already shared keep working. New links skip that hop.
const MAP = "/ais/vessels";
const STATIONS = "/ais/stations";
const pre =
  "bg-well overflow-x-auto rounded-lg p-4 text-sm break-all whitespace-pre-wrap text-fg-strong";
const tokenPre = pre.replace("text-sm", "text-xs");
---

<MainLayout
  title="Get an Open Waters AIS token"
  description="A free personal token for ais.openwaters.io: send your AIS receiver's data and read the live stream with any aisstream.io client. No account, no expiry."
>
  <section class="py-12">
    <Container>
      <div class="mx-auto max-w-2xl">
        <a
          href="/ais/"
          class="text-accent hover:text-accent-hover mb-4 inline-flex items-center gap-1 text-sm font-medium"
        >
          <Icon name="mdi:arrow-left" class="size-4" />
          AIS
        </a>
        <h1 class="mb-4">Get an Open Waters AIS token</h1>
        <p class="text-lead">
          Share your AIS receiver's data and read the live stream. Free, no
          account, never expires.
        </p>
      </div>
    </Container>
  </section>

  <Container class="py-12">
    <div
      class="mx-auto max-w-2xl space-y-8"
      data-token-page
      data-server={SERVER}
      data-stations={STATIONS}
    >
      <Card data-form>
        <p class="text-fg-muted mb-5">
          Your token and station are tied to this browser. Come back any time to
          get the same station id or to rename it. Clearing this browser's data
          starts a new station.
        </p>
        <label class="mb-5 block">
          <span class="mb-1 block text-sm font-medium">Station name</span>
          <input
            type="text"
            data-name
            maxlength="40"
            placeholder="Quissett Harbor"
            class="border-line bg-surface w-full rounded-lg border px-3 py-2"
          />
          <span class="text-fg-faint mt-1 block text-sm">
            Optional and public. Shown on the station list and the map. Leave it
            empty and the station is labeled by the town nearest the traffic it
            hears.
          </span>
        </label>
        <label class="text-fg-muted mb-5 flex items-start gap-3 text-sm">
          <input type="checkbox" data-agree class="mt-1" />
          <span>
            I accept the <a
              href="https://github.com/openwatersio/aiscast/blob/main/docs/contributor-agreement.md"
              >contributor agreement</a
            >: the data I send is my station's own reception, my receptions are
            dedicated to the public domain (CC0), and the aggregate is published
            under ODbL.
          </span>
        </label>
        <label class="text-fg-muted mb-5 flex items-start gap-3 text-sm">
          <input type="checkbox" data-bind class="mt-1" />
          <span>
            Also bind this network address, so a UDP receiver sending from here
            counts toward this token and takes its name. The token then only
            works from this address. If your address changes, so does the UDP
            station, so a receiver that can use the token below keeps its name
            better.
          </span>
        </label>
        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-go
            disabled
            class="btn btn-primary disabled:cursor-not-allowed disabled:opacity-50"
          >
            <Icon name="mdi:key-variant" class="size-5" />
            <span data-go-label>Generate token</span>
          </button>
          <span data-status class="text-fg-faint text-sm"></span>
        </div>
      </Card>

      <div data-out hidden class="space-y-8">
        <Card>
          <div class="mb-5 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="text-xl font-semibold">Your station</h2>
              <p data-sub class="text-fg-faint truncate font-mono text-sm"></p>
            </div>
            <a
              data-stlink
              href={MAP}
              class="btn btn-secondary shrink-0 text-sm"
            >
              View station
              <Icon name="mdi:chevron-right" class="size-4" />
            </a>
          </div>
          <div class="bg-well mb-5 flex items-center gap-3 rounded-lg p-4">
            <span class="relative flex size-3 shrink-0">
              <span
                data-rx-ping
                hidden
                class="bg-cta absolute inline-flex size-full animate-ping rounded-full opacity-75"
              ></span>
              <span data-rx-dot class="bg-fg-faint relative size-3 rounded-full"
              ></span>
            </span>
            <div>
              <p
                class="text-fg-faint text-xs font-medium tracking-wide uppercase"
              >
                Live status
              </p>
              <p data-rx role="status" class="text-fg-strong font-medium">
                Checking for data…
              </p>
            </div>
          </div>
          <h3 class="mb-2 text-base font-semibold">Token</h3>
          <pre data-token class={tokenPre}></pre>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <button type="button" data-copy class="btn btn-secondary text-sm">
              <Icon name="mdi:content-copy" class="size-4" />
              <span data-copy-label>Copy</span>
            </button>
            <button
              type="button"
              data-regen
              class="text-fg-muted hover:text-accent-hover cursor-pointer text-sm underline-offset-4 hover:underline"
            >
              Regenerate token
            </button>
          </div>
        </Card>

        <Card>
          <h2 class="mb-4 text-xl font-semibold">Send your receiver's data</h2>
          <h3 class="mb-1 text-base font-semibold">AIS-catcher</h3>
          <p class="text-fg-muted mb-3 text-sm">
            Starting with a USB RTL-SDR? Download a config with your token,
            receiver input, and Open Waters output already filled in. Follow the{
              " "
            }
            <a href="/ais/getting-started/ashore/#install">shore setup guide</a
            >{" "}
            to install and launch it, then press Start in the dashboard.
          </p>
          <a
            data-config-download
            download="aiscatcher.json"
            class="btn btn-primary mb-3"
          >
            Download AIS-catcher config
          </a>
          <p class="text-fg-muted mb-5 text-sm">
            This file contains your private token. Keep it private. It is for a
            new RTL-SDR setup; don't replace an existing receiver's config.
            AIS-catcher's separate community sharing is disabled.
          </p>
          <p class="text-fg-muted mb-2 text-sm">
            Already have a receiver setup? Its command-line MQTT output:
          </p>
          <pre data-cmd-aiscatcher class={`${pre} mb-3`}></pre>
          <p class="text-fg-muted mb-2 text-sm">
            Or its HTTP output, one batch every five seconds:
          </p>
          <pre data-cmd-aiscatcher-http class={`${pre} mb-5`}></pre>
          <h3 class="mb-1 text-base font-semibold">Signal K</h3>
          <p class="text-fg-muted mb-5 text-sm">
            Install <code class="bg-surface rounded px-1">signalk-aiscast</code> from
            the App Store. It creates its own token; nothing to paste.
          </p>
          <h3 class="mb-1 text-base font-semibold">UDP</h3>
          <p class="text-fg-muted text-sm">
            docker-shipfeeder or any forwarder: host <code
              class="bg-surface rounded px-1">udp.ais.openwaters.io</code
            >, port <code class="bg-surface rounded px-1">10110</code>, no
            token. The station appears as an anonymous <code
              class="bg-surface rounded px-1">udp:…</code
            > unless you bound this address above.
          </p>
        </Card>

        <Card>
          <h2 class="mb-2 text-xl font-semibold">Read the stream</h2>
          <p class="text-fg-muted mb-3 text-sm">
            Any aisstream.io client: hostname <code
              class="bg-surface rounded px-1">ais.openwaters.io</code
            >, API key = your token. Or from a shell:
          </p>
          <pre data-cmd-ws class={pre}></pre>
        </Card>
      </div>

      <p class="text-fg-faint text-sm">
        Personal tokens get 2 concurrent streams, 50 messages a second each, and
        400 square degrees of subscribed area. Contribute data and the same
        token becomes a contributor on its own: 5 streams, 200 messages a
        second, any area, and the raw NMEA feed. <a href="/ais#limits"
          >Tiers and limits</a
        >. Need more than that? <a href={`mailto:${CONTACT_EMAIL}`}
          >{CONTACT_EMAIL}</a
        >.
      </p>
    </div>
  </Container>
</MainLayout>

<script>
  import { aiscatcherConfig } from "../../utils/aiscatcher-config";
  import { stationStatus } from "../../utils/station-status";
  import { track } from "../../utils/analytics";

  const root = document.querySelector<HTMLElement>("[data-token-page]")!;
  const server = root.dataset.server!;
  const stations = root.dataset.stations!;
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const form = $("[data-form]");

  type Claims = { sub: string; exp?: number };
  function usableToken(
    value: unknown,
  ): value is { token: string; claims: Claims; name_error?: string } {
    if (!value || typeof value !== "object") return false;
    const { token, claims } = value as { token?: unknown; claims?: Claims };
    if (
      typeof token !== "string" ||
      !/^ak1\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]{86}$/.test(token) ||
      !claims ||
      typeof claims.sub !== "string" ||
      !/^ed25519:[A-Za-z0-9_-]{43}$/.test(claims.sub) ||
      (claims.exp !== undefined &&
        (typeof claims.exp !== "number" ||
          !Number.isFinite(claims.exp) ||
          (claims.exp !== 0 && claims.exp * 1000 <= Date.now())))
    )
      return false;
    try {
      const body = JSON.parse(
        atob(token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/")),
      );
      return (
        body.sub === claims.sub &&
        body.exp === (claims.exp ?? 0) &&
        body.role === "personal"
      );
    } catch {
      return false;
    }
  }

  function storedToken() {
    try {
      const value: unknown = JSON.parse(
        localStorage.getItem("aiscast.token") ?? "null",
      );
      return usableToken(value) ? value : null;
    } catch {
      return null;
    }
  }
  const b64url = (buf: ArrayBuffer) =>
    btoa(String.fromCharCode(...new Uint8Array(buf)))
      .replace(/\+/g, "-")
      .replace(/\//g, "_")
      .replace(/=+$/, "");

  // The keypair is the device identity: returning with the same public key
  // yields the same station id, and the private key signs every request, so
  // nobody else can get a token for this station or rename it.
  async function deviceKey(): Promise<{ pub: string; priv: JsonWebKey }> {
    const saved = localStorage.getItem("aiscast.device");
    if (saved) return JSON.parse(saved);
    const kp = await crypto.subtle.generateKey({ name: "Ed25519" }, true, [
      "sign",
      "verify",
    ]);
    const dev = {
      pub: b64url(await crypto.subtle.exportKey("raw", kp.publicKey)),
      priv: await crypto.subtle.exportKey("jwk", kp.privateKey),
    };
    localStorage.setItem("aiscast.device", JSON.stringify(dev));
    return dev;
  }

  let configUrl: string | undefined;
  function show(token: string, claims: Claims) {
    if (configUrl) URL.revokeObjectURL(configUrl);
    configUrl = URL.createObjectURL(
      new Blob([aiscatcherConfig(token)], {
        type: "application/json",
      }),
    );
    $<HTMLAnchorElement>("[data-config-download]").href = configUrl;
    $("[data-token]").textContent = token;
    const subEl = $("[data-sub]");
    subEl.textContent = abbreviate(claims.sub);
    subEl.title = claims.sub;
    // Left unencoded: the id's colons and slashes are legal in a path, the route is a
    // splat, and this is the address /ais/vessels?station= redirects to, so the link a
    // volunteer copies is already the canonical one.
    $<HTMLAnchorElement>("[data-stlink]").href =
      `${stations}/station:${claims.sub}`;
    $("[data-cmd-aiscatcher]").textContent =
      `AIS-catcher -d:0 -Q wssmqtt://x:${token}@${server.replace(/^https?:\/\//, "")}:443/v1/stream MSGFORMAT NMEA`;
    $("[data-cmd-aiscatcher-http]").textContent =
      `AIS-catcher -d:0 -H ${server}/v1/receive USERPWD x:${token} GZIP on INTERVAL 5`;
    $("[data-cmd-ws]").textContent =
      `websocat ${server.replace(/^http/, "ws")}/v0/stream\n{"APIKey":"${token}","BoundingBoxes":[[[41,-71.5],[42.5,-69.5]]]}`;
    $("[data-out]").hidden = false;
    form.hidden = true;
    clearInterval(rxTimer);
    checkReceiving(claims.sub);
    rxTimer = setInterval(() => checkReceiving(claims.sub, true), 60_000);
  }

  // ed25519:FtsAVnQJaoWPFk3G… → FtsAVn…Dkb4o; the title keeps the full id.
  function abbreviate(sub: string) {
    const key = sub.slice(sub.indexOf(":") + 1);
    return key.length > 14 ? `${key.slice(0, 6)}…${key.slice(-5)}` : key;
  }

  let rxTimer: ReturnType<typeof setInterval> | undefined;
  // A slow check could finish after a newer one and show an older status, so
  // a poll waits for the check in flight, and only the latest check may write.
  let rxSeq = 0;
  let rxBusy = false;
  let receivingObserved = false;

  async function checkReceiving(sub: string, poll = false) {
    if (poll && rxBusy) return;
    const seq = ++rxSeq;
    rxBusy = true;
    const text = $("[data-rx]");
    const dot = $("[data-rx-dot]");
    const ping = $("[data-rx-ping]");
    const light = (color: string) => {
      dot.className = `relative size-3 rounded-full ${color}`;
      ping.hidden = color !== "bg-cta";
    };
    // Rewriting the same text makes some screen readers announce it again.
    const say = (msg: string) => {
      if (text.textContent !== msg) text.textContent = msg;
    };
    try {
      const res = await fetch(`${server}/v1/stations/station:${sub}`);
      if (!res.ok && res.status !== 404) throw new Error(String(res.status));
      const lastAge: number | null = res.ok
        ? (await res.json()).station.last_age_s
        : null;
      if (seq !== rxSeq) return;
      const { receiving, message } = stationStatus(lastAge);
      say(message);
      light(
        receiving ? "bg-cta" : lastAge == null ? "bg-fg-faint" : "bg-highlight",
      );
      if (receiving && !receivingObserved) {
        receivingObserved = true;
        track("ais_station_receiving_observed");
      }
    } catch {
      if (seq !== rxSeq) return;
      say("Couldn't check station status");
      light("bg-fg-faint");
    } finally {
      if (seq === rxSeq) rxBusy = false;
    }
  }

  // The lines a token request signs, as the server checks them: no newline at
  // the end, and a blank line for the vessel name, which only Signal K sends.
  async function sign(
    dev: { pub: string; priv: JsonWebKey },
    ts: number,
    bind: boolean,
    name: string,
  ) {
    const key = await crypto.subtle.importKey(
      "jwk",
      dev.priv,
      { name: "Ed25519" },
      false,
      ["sign"],
    );
    const msg = [
      "aiscast-key",
      dev.pub,
      String(ts),
      bind ? "1" : "0",
      name,
      "",
    ].join("\n");
    return b64url(
      await crypto.subtle.sign(
        { name: "Ed25519" },
        key,
        new TextEncoder().encode(msg),
      ),
    );
  }

  const nameInput = $<HTMLInputElement>("[data-name]");
  nameInput.value = localStorage.getItem("aiscast.name") ?? "";

  const status = $("[data-status]");
  const agree = $<HTMLInputElement>("[data-agree]");
  const go = $<HTMLButtonElement>("[data-go]");
  const syncGoDisabled = () => (go.disabled = !agree.checked);
  agree.addEventListener("change", syncGoDisabled);
  syncGoDisabled();
  // The server accepts a signed request only if its ts is later than the last
  // one for this key, so two requests in one second need distinct stamps.
  function nextTs(): number {
    const ts = Math.max(
      Math.floor(Date.now() / 1000),
      Number(localStorage.getItem("aiscast.ts") ?? 0) + 1,
    );
    localStorage.setItem("aiscast.ts", String(ts));
    return ts;
  }

  $("[data-go]").addEventListener("click", async () => {
    go.disabled = true; // one request at a time
    status.textContent = "…";
    try {
      const operation = storedToken() ? "reissue" : "initial";
      if (!crypto?.subtle) throw new Error("this browser has no WebCrypto");
      const dev = await deviceKey();
      const bind = $<HTMLInputElement>("[data-bind]").checked;
      const name = nameInput.value.trim().replace(/\s+/g, " ");
      const ts = nextTs();
      const res = await fetch(`${server}/v1/keys`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          pubkey: dev.pub,
          bind_ip: bind,
          name,
          ts,
          sig: await sign(dev, ts, bind, name),
        }),
      });
      if (!res.ok) throw new Error(`${res.status} ${await res.text()}`);
      const response: unknown = await res.json();
      if (!usableToken(response)) throw new Error("Invalid token response");
      const { token, claims, name_error } = response;
      localStorage.setItem("aiscast.token", JSON.stringify({ token, claims }));
      if (!name_error) localStorage.setItem("aiscast.name", name);
      show(token, claims);
      track("ais_token_issued", { operation });
      $("[data-go-label]").textContent = "Regenerate token";
      status.textContent = name_error
        ? `Token ready, but the name was not saved: ${name_error}.`
        : "";
      form.hidden = !name_error;
    } catch (e) {
      const msg = String((e as Error).message || e);
      status.textContent =
        msg +
        (msg.includes("Ed25519")
          ? " (Ed25519 WebCrypto needs a current Chrome, Firefox, or Safari)"
          : "");
    } finally {
      syncGoDisabled();
    }
  });

  $("[data-copy]").addEventListener("click", async () => {
    await navigator.clipboard.writeText($("[data-token]").textContent ?? "");
    const label = $("[data-copy-label]");
    label.textContent = "Copied";
    setTimeout(() => (label.textContent = "Copy"), 1500);
  });

  // Reopens the form rather than regenerating at once, so the name and
  // address binding can change with it.
  $("[data-regen]").addEventListener("click", () => {
    form.hidden = false;
    form.scrollIntoView({ behavior: "smooth", block: "start" });
    nameInput.focus({ preventScroll: true });
  });

  const prev = storedToken();
  if (prev) {
    show(prev.token, prev.claims);
    $("[data-go-label]").textContent = "Regenerate token";
  }
</script>
