---
import MainLayout from "../../../layouts/MainLayout.astro";
import Container from "../../../components/ui/Container.astro";
import Icon from "../../../components/Icon.astro";
import { CONTACT_EMAIL } from "../../../utils/constants";
import { SITE, publisher } from "../../../utils/schema";

const SERVER = "ais.openwaters.io";
const REPO = "https://github.com/openwatersio/aiscast";
const STATUS = "https://status.openwaters.io";
const ALTERNATIVES = "/ais/alternatives/aisstream/";

const sections = [
  { id: "now", title: "Right now" },
  { id: "glance", title: "At a glance" },
  { id: "protocol", title: "Protocol and compatibility" },
  { id: "coverage", title: "Coverage" },
  { id: "limits", title: "Limits and connection model" },
  { id: "license", title: "License and terms" },
  { id: "who", title: "Who each one is for" },
  { id: "migration", title: "Migration" },
];

// [label, Open Waters AIS, aisstream.io]
const glance: [string, string, string][] = [
  [
    "Protocol",
    "aisstream-compatible /v0/stream plus native /v1/stream",
    "/v0/stream",
  ],
  ["Token", "one click, no account, never expires", "GitHub/Google OAuth key"],
  [
    "Read without an account",
    "yes: /v1/stream and /v1/vessels need nothing",
    "no: login and API key",
  ],
  [
    "Browser clients",
    "yes, CORS open",
    "banned; proxy through your own server",
  ],
  [
    "Historical analysis",
    "REST vessel tracks as GeoJSON or GPX; coverage varies",
    "no durable replay documented",
  ],
  ["Current vessel lookups", "REST by area or vessel", "stream only"],
  [
    "Limits",
    "documented, per token: 2 streams, 50 msg/s, ~20°×20° personal; more for contributors",
    "3 subscribed connections per account and 3 open connections per IP",
  ],
  [
    "Failure signalling",
    "ack, heartbeat, close reason, /health, public status page",
    "subscription confirmations; reconnect and keepalive guidance",
  ],
  [
    "Coverage",
    "Norway and Finland live, volunteers live, world via AISHub about a minute behind, aisstream.io when up",
    "global terrestrial when up",
  ],
  ["Source on each event", "yes, with station", "no"],
  ["Live coverage map", "yes, per station and source", "no"],
  [
    "Data license",
    "per source, published, attribution strings given",
    "confirm reuse terms",
  ],
  ["Contribute a receiver", "yes: HTTP, UDP, Signal K", "no"],
  ["Raw NMEA", "contributors and commercial", "no"],
  [
    "Code",
    "MIT, public: run your own, or fork it if we disappear",
    "closed; public repo empty, nothing to fork",
  ],
  ["Uptime", "beta, no SLA; monitored publicly", "no SLA or uptime guarantee"],
  ["Cost", "free personal access; contact us for commercial use", "free"],
  [
    "A human to email",
    "hello@openwaters.io answers",
    "GitHub issues, unanswered",
  ],
];

// Live rows: the Open Waters AIS column sums every source; the aisstream column is what
// aisstream.io delivers to this server's own world-wide subscription, since it is
// one of our upstreams. Both are measured by the same process.
const live = [
  { label: "Vessels, last 30 min", ours: "vessels", theirs: "as_vessels" },
  { label: "Events, last 24 h", ours: "events", theirs: "as_events" },
  { label: "Last message", ours: "age", theirs: "as_age" },
  { label: "Stations on the map", ours: "stations", theirs: "" },
];

const description =
  "Compare Open Waters AIS and aisstream.io for real-time vessel tracking and historical analysis: streams, vessel tracks, coverage, limits, and migration.";

const article = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "Open Waters AIS vs aisstream.io",
  description,
  url: `${SITE}/ais/vs/aisstream/`,
  author: publisher,
  publisher,
  isAccessibleForFree: true,
  proficiencyLevel: "Expert",
  articleSection: sections.map((s) => s.title),
};
---

<MainLayout
  title="Open Waters AIS vs aisstream.io"
  image="/og/ais-vs-aisstream.png"
  description={description}
  schema={article}
>
  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <a
        href="/ais/"
        class="text-accent hover:text-accent-hover mb-4 inline-flex items-center gap-1 text-sm font-medium"
      >
        <Icon name="mdi:arrow-left" class="size-4" />
        AIS
      </a>

      <h1 class="mb-2">Open Waters AIS vs aisstream.io</h1>
      <p class="text-fg-faint mb-4 text-sm">
        API documentation checked 8 October 2026
      </p>

      <p class="text-lead mb-4">
        Open Waters AIS serves two workflows: following vessels in real time and
        analysing their recorded movements. aisstream.io provides a free live
        WebSocket feed. Open Waters AIS adds historical vessel tracks over REST,
        current vessel lookups, and commercial access by arrangement. Its
        compatibility endpoint accepts aisstream subscriptions, so existing
        clients can start with a hostname and token change.
      </p>
      <p class="text-fg-muted mb-8">
        Comparing more than these two? <a href={ALTERNATIVES}
          >All aisstream.io alternatives</a
        >.
      </p>

      <nav
        data-nosnippet
        aria-label="On this page"
        class="border-line bg-surface mb-12 rounded-lg border px-5 py-4 text-sm"
      >
        <span class="mr-2 font-semibold">On this page:</span>
        {
          sections.map((s, i) => (
            <>
              {i > 0 && <span class="text-fg-faint mx-2">·</span>}
              <a href={`#${s.id}`} class="text-accent hover:text-accent-hover">
                {s.title}
              </a>
            </>
          ))
        }
      </nav>

      <article>
        <h2 id="now" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          Right now
        </h2>
        <p class="text-fg-muted mb-4">
          aisstream.io is one of our upstreams, so the same server measures both
          columns: everything Open Waters AIS hears, and what aisstream.io
          delivers to a world-wide subscription on one key. When aisstream is
          healthy this table says so.
        </p>
        <div
          id="vs-live"
          data-nosnippet
          data-src={`https://${SERVER}/v1/stats`}
          class="mb-4 overflow-x-auto"
        >
          <table class="w-full min-w-lg text-sm">
            <thead class="bg-surface">
              <tr>
                <th scope="col" class="px-3 py-2 text-left"></th>
                <th scope="col" class="px-3 py-2 text-right">Open Waters AIS</th
                >
                <th scope="col" class="px-3 py-2 text-right">aisstream.io</th>
              </tr>
            </thead>
            <tbody class="divide-line divide-y">
              {
                live.map((r) => (
                  <tr>
                    <th scope="row" class="px-3 py-2 text-left font-medium">
                      {r.label}
                    </th>
                    <td
                      class="px-3 py-2 text-right text-lg font-semibold tabular-nums"
                      data-stat={r.ours}
                    >
                      –
                    </td>
                    <td
                      class="px-3 py-2 text-right text-lg font-semibold tabular-nums"
                      data-stat={r.theirs || undefined}
                    >
                      {r.theirs ? "–" : <span class="text-fg-faint">—</span>}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-fg-faint mb-12 text-sm">
          Vessels are distinct MMSIs heard in the last 30 minutes; events are
          deduplicated across sources. Updated every 5 seconds from{" "}
          <a href={`https://${SERVER}/v1/stats`}>/v1/stats</a>. A dash in the
          aisstream column means it has delivered nothing since this server last
          restarted.
        </p>

        <h2 id="glance" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          At a glance
        </h2>
        <div class="mb-12 overflow-x-auto">
          <table class="w-full min-w-lg text-sm">
            <thead class="bg-surface">
              <tr>
                <th scope="col" class="px-3 py-2 text-left"></th>
                <th scope="col" class="px-3 py-2 text-left">Open Waters AIS</th>
                <th scope="col" class="px-3 py-2 text-left">aisstream.io</th>
              </tr>
            </thead>
            <tbody class="divide-line divide-y">
              {
                glance.map(([label, ours, theirs]) => (
                  <tr>
                    <th scope="row" class="px-3 py-2 text-left font-medium">
                      {label}
                    </th>
                    <td class="text-fg-muted px-3 py-2">{ours}</td>
                    <td class="text-fg-muted px-3 py-2">{theirs}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-fg-faint mb-12 text-sm">
          aisstream.io claims come from its{" "}
          <a
            href="https://aisstream.io/documentation"
            target="_blank"
            rel="noopener noreferrer">documentation</a
          >{" "}
          checked 8 October 2026. Open Waters AIS capabilities are documented in the{
            " "
          }
          <a href="/api/ais/">API reference</a>. Spotted something out of date?{
            " "
          }
          <a href="/contact/">Tell us</a>.
        </p>

        <h2 id="protocol" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          Protocol and compatibility
        </h2>
        <p class="text-fg-muted mb-4">
          aisstream's JSON is Go's <code class="bg-surface rounded px-1"
            >encoding/json</code
          > over the go-ais structs, typo and all (<code
            class="bg-surface rounded px-1">VenderIDModel</code
          >). Open Waters AIS uses the same decoder, so <code
            class="bg-surface rounded px-1">/v0/stream</code
          > frames are structurally identical; golden tests pin the envelope, rounding,
          time format, error messages, and resubscribe behaviour against captured
          aisstream output. Verified clients: <code
            class="bg-surface rounded px-1">aisstream-ts</code
          >, the official Go, Python and JavaScript examples, and <code
            class="bg-surface rounded px-1">signalk-aisstream</code
          >. Where aisstream's decoder is known wrong, <code
            class="bg-surface rounded px-1">/v0</code
          > reproduces the quirk deliberately and <code
            class="bg-surface rounded px-1">/v1</code
          > fixes it; the <a href="/api/ais/">API reference</a> lists each one.
        </p>
        <p class="text-fg-muted mb-12">
          Start with a hostname and token change, then test your filters,
          limits, and control-message handling. aisstream now documents
          subscription confirmations, compression negotiation, and binary JSON
          frames; do not assume every transport detail is identical.
        </p>

        <h2 id="coverage" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          Coverage
        </h2>
        <p class="text-fg-muted mb-4">
          Both services depend on the receivers and upstreams that hear a
          vessel. Compare your actual area or vessel list, and the age of its
          reports, rather than treating “global” as continuous ocean coverage.
        </p>
        <p class="text-fg-muted mb-4">
          Open Waters AIS publishes every source: Kystverket and BarentsWatch
          for Norway, Digitraffic for Finland, volunteer receivers wherever they
          are, the AISHub aggregate for the rest of the world, and aisstream.io
          itself when it is delivering. <code class="bg-surface rounded px-1"
            >/v1/stations</code
          > gives each source's message count and age, and the live map draws the
          same data. Use the <a href="/ais/">coverage map</a> and source health to
          investigate missing or delayed positions.
        </p>
        <p class="text-fg-muted mb-12">
          The gap: outside the Nordics and the volunteer footprint, our
          positions are AISHub's, about a minute behind (<a
            href="https://ais.openwaters.io/v1/stats"
            target="_blank"
            rel="noopener noreferrer">current delay</a
          >). That is fine for "what is out there" and wrong for close quarters.
          Coverage grows as receivers join. Neither a live feed nor historical
          tracks are a substitute for onboard AIS or suitable for safety of
          navigation.
        </p>

        <h2 id="limits" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          Limits and connection model
        </h2>
        <p class="text-fg-muted mb-4">
          aisstream documents three subscribed connections per account and three
          open connections per originating IP. Subscription updates replace the
          active configuration, are limited to one per second, and receive a
          confirmation when accepted. Browser connections require a server
          proxy.
        </p>
        <p class="text-fg-muted mb-12">
          Open Waters AIS limits per token, publishes the numbers, thins a
          stream that exceeds its rate rather than dropping the connection,
          refuses an oversize area with a message that says so, and allows
          in-band resubscribe for free. CORS is open on <code
            class="bg-surface rounded px-1">/v1/vessels</code
          >.
        </p>

        <h2 id="license" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          License and terms
        </h2>
        <p class="text-fg-muted mb-12">
          Confirm the terms for your intended use before displaying, storing, or
          redistributing AIS data. Open Waters AIS publishes <a
            href="/ais/#license">source terms and attribution</a
          >; a commercial subscription does not erase upstream conditions.
          Contact us about the sources your product can use, including whether
          to exclude aisstream data when its reuse terms do not meet your
          requirements.
        </p>

        <h2 id="who" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          Who each one is for
        </h2>
        <h3 class="mb-2 text-xl font-semibold">Real-time tracking</h3>
        <p class="text-fg-muted mb-6">
          Marine apps, fleet monitors, and dashboards can consume Open Waters
          AIS as a stream, or poll the REST API when periodic updates are
          enough. Current-position snapshots help initialise a map before live
          updates arrive. aisstream is an option for a free server-side stream
          when its coverage and terms fit your project.
        </p>
        <h3 class="mb-2 text-xl font-semibold">Historical analysis</h3>
        <p class="text-fg-muted mb-6">
          To reconstruct movements or study vessel activity, use the <a
            href="/api/ais/#get-v1-vessels-mmsi-track"
            >Open Waters AIS vessel-track API</a
          >. It returns GeoJSON or GPX for a requested time range, with up to
          366 days per request. That limit does not promise a year of
          observations: check the recorded dates, gaps, and sampling for the
          vessels you need. IMO lookup is available to contributor and
          commercial tokens, but tracks under earlier MMSIs are not
          automatically joined.
        </p>
        <p class="text-fg-muted mb-12">
          <a href="/ais/token/">Try personal access</a> or <a href="/contact/"
            >discuss a commercial project</a
          >. For historical work, include your vessel list, area, date range,
          and required detail. Bulk datasets and contractual requirements need a
          separate discussion; they are not implied by the public track
          endpoint.
        </p>

        <h2 id="migration" class="mb-4 scroll-mt-24 text-3xl font-semibold">
          Migration
        </h2>
        <ol
          class="text-fg-muted marker:text-fg-faint mb-4 list-decimal space-y-2 pl-6"
        >
          <li>
            Get a token at <a href="/ais/token/">openwaters.io/ais/token</a>{
              " "
            }
            for personal use. For a commercial product, <a href="/contact/"
              >contact us</a
            > for access.
          </li>
          <li>
            Replace <code class="bg-surface rounded px-1"
              >wss://stream.aisstream.io/v0/stream</code
            > with <code class="bg-surface rounded px-1"
              >wss://ais.openwaters.io/v0/stream</code
            >.
          </li>
          <li>
            Put the token in <code class="bg-surface rounded px-1">APIKey</code
            >. Test your subscriptions and message handling before switching
            production traffic.
          </li>
        </ol>
        <p class="text-fg-muted mb-4">
          The full version, including what changes once you are across, is on <a
            href={`${ALTERNATIVES}#switch`}>All aisstream.io alternatives</a
          >.
        </p>
        <p class="text-fg-muted">
          Support: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, or
          an issue on the <a
            href={REPO}
            target="_blank"
            rel="noopener noreferrer">aiscast repository</a
          >. Current uptime is at <a
            href={STATUS}
            target="_blank"
            rel="noopener noreferrer">status.openwaters.io</a
          >.
        </p>
      </article>
    </div>
  </Container>
</MainLayout>

<script>
  const root = document.getElementById("vs-live");
  if (root) {
    const src = root.dataset.src!;
    const ago = (s: number) =>
      s < 60
        ? `${s}s ago`
        : s < 3600
          ? `${Math.round(s / 60)}m ago`
          : `${Math.round(s / 3600)}h ago`;
    const show = (key: string, value: string) => {
      const el = root.querySelector(`[data-stat=${key}]`);
      if (el) el.textContent = value;
    };
    const poll = async () => {
      try {
        const s = await (await fetch(src)).json();
        show("vessels", s.vessels.total.toLocaleString());
        show("events", s.events.last_24h.toLocaleString());
        show("stations", s.stations.active.toLocaleString());
        const ages = Object.values(s.sources).map(
          (v: any) => v.last_age_s as number,
        );
        show("age", ago(Math.min(...ages)));
        const a = s.sources.aisstream;
        if (!a) return;
        show("as_vessels", a.vessels.toLocaleString());
        show("as_events", a.events.last_24h.toLocaleString());
        show("as_age", ago(a.last_age_s));
      } catch {
        // leave the placeholders
      }
    };
    poll();
    setInterval(poll, 5000);
  }
</script>
