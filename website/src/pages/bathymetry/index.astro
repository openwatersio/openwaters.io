---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import FeatureCard from "../../components/ui/FeatureCard.astro";
---

<MainLayout
  title="Bathymetry"
  description="Open bathymetry projects — collect depth data from your vessel with Crowd Depth, and explore Seascape, a map of the seafloor built from global open bathymetry."
>
  <!-- Hero -->
  <section class="bg-linear-to-b from-(--hero-from) to-(--hero-to) py-16">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6">Bathymetry</h1>
        <p class="text-lead">
          Mapping the seafloor with open data — from collecting depth soundings
          on your vessel to ready-to-use web map tiles.
        </p>
      </div>
    </Container>
  </section>

  <!-- Projects -->
  <Container class="py-16">
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
      <FeatureCard
        href="/bathymetry/crowd-depth"
        title="Crowd Depth"
        description="Collect and share depth soundings from your vessel with a Signal K plugin, and contribute to crowd-sourced bathymetry programs."
        action="About Crowd Depth"
        icon="mdi:anchor"
      />

      <FeatureCard
        href="/charts/seascape"
        title="Seascape"
        description="A map of the seafloor built from global open bathymetry with contours, depth shading, and soundings."
        action="Explore Seascape"
        icon="mdi:map-outline"
      />
    </div>
  </Container>
</MainLayout>
