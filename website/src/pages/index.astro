---
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
import ChartMap from "../components/charts/ChartMap.astro";
import Icon from "../components/Icon.astro";
import { CONTACT_EMAIL } from "../utils/constants";

// Framings match the /charts cards.
const charts = [
  {
    id: "seamap" as const,
    name: "Seamap",
    center: [-122.75, 48.53] as [number, number],
    zoom: 8.6,
    description: "A nautical-themed map with depths, seamarks, and hazards.",
  },
  {
    id: "seascape" as const,
    name: "Seascape",
    center: [1.3, 51.6] as [number, number],
    zoom: 9,
    description:
      "A map of the seafloor with contours, depth shading, and soundings.",
  },
];
---

<MainLayout>
  <!-- Hero Section -->
  <section class="py-20">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="mb-6 font-bold">Open Source Marine Software and Data</h1>
        <p class="text-lead">
          Understand and navigate the sea with tools built through open source
          collaboration.
        </p>
      </div>
    </Container>
  </section>

  <!-- Features Section -->
  <section class="py-16">
    <Container>
      <h2 class="sr-only">Tools and data</h2>
      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
        <!-- Charts -->
        {
          charts.map((chart) => (
            <Card href={`/charts/${chart.id}/`} class="space-y-3">
              <div class="border-line overflow-hidden rounded-lg border">
                <ChartMap
                  class="pointer-events-none aspect-video w-full"
                  chart={chart.id}
                  center={chart.center}
                  zoom={chart.zoom}
                  interactive={false}
                />
              </div>
              <h3 class="text-3xl md:text-4xl lg:text-5xl">{chart.name}</h3>
              <p class="text-fg-muted text-pretty">{chart.description}</p>
              <span class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium">
                Explore {chart.name}
                <svg
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </span>
            </Card>
          ))
        }

        <!-- Tides -->
        <Card href="/tides/" class="space-y-3">
          <div class="text-accent">
            <svg
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-3xl md:text-4xl lg:text-5xl">Tides</h3>
          <p class="text-fg-muted">
            Tide predictions powered by the Neaps engine, with data from
            thousands of stations worldwide.
          </p>
          <span
            class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium"
          >
            Explore tides
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </Card>

        <!-- AIS -->
        <Card href="/ais/" class="space-y-3">
          <div class="text-accent">
            <Icon name="mdi:radar" class="size-12" />
          </div>
          <h3 class="text-3xl md:text-4xl lg:text-5xl">AIS</h3>
          <p class="text-fg-muted">
            aiscast streams live vessel traffic from open government feeds and
            volunteer receivers, by bounding box.
          </p>
          <span
            class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium"
          >
            Explore AIS
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </Card>

        <!-- Sky -->
        <Card href="/sky/" class="space-y-3">
          <div class="text-accent">
            <Icon name="mdi:weather-sunset-up" class="size-12" />
          </div>
          <h3 class="text-3xl md:text-4xl lg:text-5xl">Sky</h3>
          <p class="text-fg-muted">
            Sunrise, moon phase, stars and lunar eclipses for any position,
            computed offline by the Almanac engine.
          </p>
          <span
            class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium"
          >
            Explore the sky
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </Card>

        <!-- Bathymetry -->
        <Card href="/bathymetry/" class="space-y-3">
          <div class="text-accent">
            <svg
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
              ></path>
            </svg>
          </div>
          <h3 class="text-3xl md:text-4xl lg:text-5xl">Bathymetry</h3>
          <p class="text-fg-muted">
            Collect and share depth data from your vessel to contribute to
            crowd-sourced bathymetry programs.
          </p>
          <span
            class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium"
          >
            Learn more
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </Card>
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-16">
    <Container>
      <div
        class="card text-fg-strong mx-auto max-w-4xl space-y-6 rounded-2xl p-10 text-center"
      >
        <h2 class="text-fg-strong">Get Involved</h2>
        <p class="text-fg-muted mx-auto max-w-2xl text-xl text-balance">
          Join our community of mariners, developers, and ocean enthusiasts
          building better tools for the sea.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://github.com/openwatersio"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <Icon name="mdi:github" class="size-6" />
            View on GitHub
          </a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-secondary">
            Get in Touch
          </a>
        </div>
      </div>
    </Container>
  </section>
</MainLayout>
