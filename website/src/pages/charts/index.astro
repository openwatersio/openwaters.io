---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import SeascapeMap from "../../components/charts/SeascapeMap.astro";
import Icon from "../../components/Icon.astro";
---

<MainLayout
  title="Charts"
  description="Ready-to-use ocean map layers for MapLibre and Mapbox GL — Seascape seafloor bathymetry tiles from Open Waters."
>
  <!-- Hero -->
  <section class="bg-linear-to-b from-(--hero-from) to-(--hero-to) py-16">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6">Charts</h1>
        <p class="text-lead">
          Ready-to-use ocean map layers for MapLibre and Mapbox GL, built from
          open data and served as XYZ tiles.
        </p>
      </div>
    </Container>
  </section>

  <!-- Chart list -->
  <Container class="py-16">
    <div class="mx-auto max-w-4xl space-y-16">
      <section class="grid items-center gap-8 md:grid-cols-3">
        <a
          href="/charts/seascape"
          class="block overflow-hidden rounded-lg border border-(--border) shadow-sm transition-shadow hover:shadow-md"
          aria-label="Seascape preview"
        >
          {/* pointer-events-none so the whole preview acts as a link */}
          <SeascapeMap
            class="pointer-events-none aspect-4/3 w-full"
            center={[1.3, 51.6]}
            zoom={9}
            interactive={false}
          />
        </a>
        <div class="md:col-span-2">
          <h2 class="mb-3 text-3xl font-semibold">
            <a href="/charts/seascape" class="hover:text-(--accent)">
              Seascape
            </a>
          </h2>
          <p class="mb-4 text-(--text-secondary)">
            Global seafloor bathymetry as web map tiles — raster DEM for depth
            shading, hillshade, and 3D terrain, plus vector contours for crisp
            lines and labels. Built from a mosaic of global and regional open
            data sources.
          </p>
          <a
            href="/charts/seascape"
            class="inline-flex items-center gap-1 font-medium text-(--accent) hover:text-(--accent-hover)"
          >
            Explore Seascape
            <Icon name="mdi:arrow-right" class="size-5" />
          </a>
        </div>
      </section>
    </div>
  </Container>
</MainLayout>
