---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import ChartMap from "../../components/charts/ChartMap.astro";
import Icon from "../../components/Icon.astro";

const charts = [
  {
    id: "seamap" as const,
    name: "Seamap",
    // Salish Sea, Rosario Strait — buoyage, ferry routes, and marinas. Framed
    // tighter than the page hero: a card this size shows far less at one zoom.
    center: [-122.75, 48.53] as [number, number],
    zoom: 8.6,
    description: "A nautical-themed map with depths, seamarks, and hazards.",
  },
  {
    id: "seascape" as const,
    name: "Seascape",
    // Thames estuary — banks and channels in high-resolution survey data
    center: [1.3, 51.6] as [number, number],
    zoom: 9,
    description:
      "A map of the seafloor built from global open bathymetry with contours, depth shading, and soundings.",
  },
];
---

<MainLayout
  title="Charts"
  description="Ready-to-use nautical-themed web map tiles."
>
  <!-- Hero -->
  <section class="bg-linear-to-b from-(--hero-from) to-(--hero-to) py-16">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6">Charts</h1>
        <p class="text-lead">
          Ready-to-use nautical-themed web map tiles.<br /> Built from open data sources
          with open source tools.
        </p>
      </div>
    </Container>
  </section>

  <!-- Chart list -->
  <Container class="py-16">
    <div class="mx-auto max-w-4xl space-y-16">
      {
        charts.map((chart) => (
          <section class="grid items-center gap-8 md:grid-cols-3">
            <a
              href={`/charts/${chart.id}/`}
              class="block overflow-hidden rounded-lg border border-(--border) shadow-sm transition-shadow hover:shadow-md"
              aria-label={`${chart.name} preview`}
            >
              {/* pointer-events-none so the whole preview acts as a link */}
              <ChartMap
                class="pointer-events-none aspect-4/3 w-full"
                chart={chart.id}
                center={chart.center}
                zoom={chart.zoom}
                interactive={false}
              />
            </a>
            <div class="md:col-span-2">
              <h2 class="mb-3 text-3xl font-semibold">
                <a href={`/charts/${chart.id}/`} class="hover:text-(--accent)">
                  {chart.name}
                </a>
              </h2>
              <p class="mb-4 text-(--text-secondary)">{chart.description}</p>
              <a
                href={`/charts/${chart.id}/`}
                class="inline-flex items-center gap-1 font-medium text-(--accent) hover:text-(--accent-hover)"
              >
                Explore {chart.name}
                <Icon name="mdi:arrow-right" class="size-5" />
              </a>
            </div>
          </section>
        ))
      }
    </div>
  </Container>
</MainLayout>
