---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import SeascapeMap from "../../components/charts/SeascapeMap.astro";
import { Icon } from "astro-icon/components";

// Source list comes from the currently deployed tiles manifest, joined with
// per-source metadata (producer, license, website) from the seascape repo.
interface Source {
  id: string;
  name?: string;
  producer?: string;
  website?: string;
  license?: string;
}

let sources: Source[] = [];
try {
  const manifest = await (
    await fetch("https://tiles.openwaters.io/seascape/manifest.json")
  ).json();
  sources = await Promise.all(
    (manifest.source_ids as string[]).map(async (id) => {
      const res = await fetch(
        `https://raw.githubusercontent.com/openwatersio/seascape/main/sources/${id}/metadata.json`,
      );
      return res.ok ? { id, ...(await res.json()) } : { id, name: id };
    }),
  );
} catch {
  // page still builds without the table if the manifest is unreachable
}
// Manifest order is alphabetical by internal id; sort by display name instead.
sources.sort((a, b) => (a.name ?? a.id).localeCompare(b.name ?? b.id));
---

<MainLayout
  title="Seascape - Charts"
  description="A map of the seafloor built from global open bathymetry, served as raster DEM and vector tiles for MapLibre and Mapbox GL."
>
  <!-- Map hero -->
  <section class="border-b border-(--border)">
    <SeascapeMap
      class="h-[60vh] min-h-96 w-full"
      center={[-23, 65.4]}
      zoom={9}
    />
  </section>

  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <a
        href="/charts"
        class="mb-6 inline-flex items-center gap-1 text-sm font-medium text-(--accent) hover:text-(--accent-hover)"
      >
        <Icon name="mdi:arrow-left" class="size-4" />
        All charts
      </a>

      <h1 class="mb-4">Seascape</h1>
      <p class="text-lead mb-4">
        A map of the seafloor built from global open bathymetry with contours,
        depth shading, and soundings.
      </p>

      <div class="mb-12 flex flex-wrap gap-3">
        <a
          href="https://github.com/openwatersio/seascape"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <Icon name="mdi:github" class="size-6" />
          Code
        </a>
        <a
          href="https://openwatersio.github.io/seascape/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <Icon name="mdi:map-outline" class="size-6" />
          Demo
        </a>
      </div>

      <!-- TOC -->
      <nav
        aria-label="On this page"
        class="mb-12 rounded-lg border border-(--border) bg-(--surface-subtle) px-5 py-4 text-sm"
      >
        <span class="mr-2 font-semibold">On this page:</span>
        <a href="#sources" class="text-(--accent) hover:text-(--accent-hover)"
          >Sources</a
        >
        <span class="mx-2 text-(--text-muted)">·</span>
        <a
          href="#how-to-use"
          class="text-(--accent) hover:text-(--accent-hover)">How to use</a
        >
        <span class="mx-2 text-(--text-muted)">·</span>
        <a href="#license" class="text-(--accent) hover:text-(--accent-hover)"
          >License</a
        >
      </nav>

      <!-- Not for navigational use -->
      <div class="mb-12 rounded-lg border-l-4 border-amber-500 bg-amber-50 p-4">
        <h2
          class="mb-2 flex items-center gap-2 text-lg font-semibold text-amber-900"
        >
          <Icon name="mdi:alert" class="size-5" /> Not for navigational use
        </h2>
        <p class="text-sm text-amber-900/90">
          Depths are <strong>not</strong> reduced to a chart datum and do not account
          for tides or water level — they are not charted depths. Data is interpolated
          and merged from sources of differing age, resolution, and datum, then smoothed
          during tiling, so values are approximate, and gridded bathymetry omits hazards
          (rocks, wrecks, obstructions) shown on official charts. Always consult official
          nautical charts for navigation.
        </p>
      </div>

      <!-- Data sources -->
      <h2 id="sources" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        Sources
      </h2>
      <p class="mb-4 text-(--text-secondary)">
        Seascape is a mosaic of {sources.length || "many"} sources. Global coverage
        is at ~450 m resolution (zoom 8), and regional detail is as low as ~8 m (zoom
        14) where high-resolution sources exist. Where sources overlap, datum-authoritative
        sources (e.g. NOAA S-102, already on a chart datum) are the highest priority,
        and then higher-resolution sources are preferred.
      </p>
      {
        sources.length > 0 ? (
          <ul class="mb-12 ml-6 list-disc space-y-3 text-sm">
            {sources.map((source) => (
              <li>
                {source.website ? (
                  <a
                    href={source.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-(--accent) hover:text-(--accent-hover)"
                  >
                    {source.name ?? source.id}
                  </a>
                ) : (
                  (source.name ?? source.id)
                )}
                <br />
                <span class="text-(--text-secondary)">
                  {source.producer} · License: {source.license}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mb-12 text-(--text-secondary)">
            See the{" "}
            <a
              href="https://tiles.openwaters.io/seascape/manifest.json"
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--accent) hover:text-(--accent-hover)"
            >
              deployed manifest
            </a>{" "}
            for the full source list.
          </p>
        )
      }

      <!-- How to use -->
      <h2 id="how-to-use" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        How to use
      </h2>

      <p class="mb-4 text-(--text-secondary)">
        Seascape is published as web map tiles: a Terrarium-encoded raster DEM
        for depth shading, hillshade, and 3D terrain, and vector tiles carrying
        contour lines, spot soundings, and drying areas. Both work with MapLibre
        GL, Mapbox GL, or any library that reads TileJSON, and a prebuilt style
        renders the complete map from a single URL.
      </p>

      <p class="mb-12 text-(--text-secondary)">
        See the
        <a
          href="https://github.com/openwatersio/seascape#usage"
          target="_blank"
          rel="noopener noreferrer"
          class="text-(--accent) hover:text-(--accent-hover)"
          >Usage section of the README</a
        > for tile URLs, a ready-to-use style, and MapLibre examples.
      </p>

      <!-- License -->
      <h2 id="license" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        License
      </h2>
      <p class="mb-4 text-(--text-secondary)">
        <strong>Tiles</strong> — the tile compilation served at <code
          class="rounded bg-(--surface-subtle) px-1"
          >tiles.openwaters.io/seascape</code
        > is licensed
        <a
          href="https://creativecommons.org/licenses/by/4.0/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-(--accent) hover:text-(--accent-hover)">CC BY 4.0</a
        >: free for any use with the following attribution:
      </p>
      <div class="bg-navy-900 mb-4 overflow-x-auto rounded-lg p-4 text-white">
        <pre
          class="text-sm"><code>© Open Water Software, LLC (https://openwaters.io/charts/seascape#license)</code></pre>
      </div>
      <p class="mb-4 text-(--text-secondary)">
        The underlying data remains under each source's own open terms, listed
        above. The full attribution list is carried in the
        <code class="rounded bg-(--surface-subtle) px-1">attribution</code> field
        of the TileJSON endpoints (<a
          href="https://tiles.openwaters.io/seascape/raster.json"
          target="_blank"
          rel="noopener noreferrer"
          class="text-(--accent) hover:text-(--accent-hover)">raster.json</a
        >,
        <a
          href="https://tiles.openwaters.io/seascape/vector.json"
          target="_blank"
          rel="noopener noreferrer"
          class="text-(--accent) hover:text-(--accent-hover)">vector.json</a
        >) and is displayed by MapLibre's attribution control automatically,
        which satisfies each source's terms.
      </p>
      <p class="mb-4 text-(--text-secondary)">
        <strong>Code</strong> — the build pipeline is
        <a
          href="https://github.com/openwatersio/seascape/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="text-(--accent) hover:text-(--accent-hover)">BSD-3-Clause</a
        >.
      </p>
    </div>
  </Container>
</MainLayout>
