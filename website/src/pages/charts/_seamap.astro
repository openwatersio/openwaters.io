---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import Card from "../../components/ui/Card.astro";
import Icon from "../../components/Icon.astro";
---

<MainLayout
  title="Seamap - Charts"
  description="Nautical chart vector tiles derived from OpenStreetMap — seamarks, light sectors, land and water, for MapLibre and Mapbox GL."
>
  <!-- Map hero -->
  <section class="border-b border-(--border)">
    <iframe
      src="https://openwatersio.github.io/seamap/"
      title="Seamap interactive preview"
      class="block h-[60vh] min-h-96 w-full"></iframe>
  </section>

  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <a
        href="/charts"
        class="mb-6 inline-flex items-center gap-1 text-sm font-medium text-(--accent) hover:text-(--accent-hover)"
      >
        <Icon name="mdi:arrow-left" class="size-4" />
        All charts
      </a>

      <h1 class="mb-4">Seamap</h1>
      <p class="text-lead mb-8">
        Nautical chart vector tiles derived directly from OpenStreetMap —
        seamarks (buoys, beacons, lights, harbours), light sectors with colored
        arcs, land and water, and more, rendered as a complete nautical chart.
      </p>

      <div class="mb-12 flex flex-wrap gap-3">
        <a
          href="https://github.com/openwatersio/seamap"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <Icon name="mdi:github" class="size-6" />
          View on GitHub
        </a>
        <a
          href="https://github.com/prozessor13/signalk-seamap-plugin"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          Offline on your boat: Signal K plugin
        </a>
      </div>

      <!-- TOC -->
      <nav
        aria-label="On this page"
        class="mb-12 rounded-lg border border-(--border) bg-(--surface-subtle) px-5 py-4 text-sm"
      >
        <span class="mr-2 font-semibold">On this page:</span>
        <a
          href="#how-to-use"
          class="text-(--accent) hover:text-(--accent-hover)">How to use</a
        >
        <span class="mx-2 text-(--text-muted)">·</span>
        <a href="#license" class="text-(--accent) hover:text-(--accent-hover)"
          >License</a
        >
      </nav>

      {
        /* TODO(seamap): ship a prebuilt style.json + a stable tile URL for one-line MapLibre ingestion, then replace this note with real usage docs. */
      }
      <!-- How to use -->
      <h2 id="how-to-use" class="mb-4 scroll-mt-24 text-3xl font-semibold">
        How to use
      </h2>
      <Card>
        <h3 class="mb-2 text-xl font-semibold">Full usage docs coming soon</h3>
        <p class="mb-3 text-(--text-secondary)">
          A drop-in style is on the way: a prebuilt <code
            class="rounded bg-(--surface-subtle) px-1">style.json</code
          > you'll be able to hand straight to MapLibre for a ready-rendered chart.
        </p>
        <p class="text-sm text-(--text-secondary)">
          In the meantime, provisional vector tiles are published at
          <a
            href="https://tiles.openwaters.io/seamap/latest.json"
            target="_blank"
            rel="noopener noreferrer"
            class="text-(--accent) hover:text-(--accent-hover)"
            >seamap/latest.json</a
          >. Note this URL is <strong>not stable yet</strong> and serves raw PMTiles
          vector tiles — you'll need the PMTiles protocol plugin and your own styling
          to render a chart from it.
        </p>
      </Card>

      <!-- License -->
      <h2 id="license" class="mt-12 mb-4 scroll-mt-24 text-3xl font-semibold">
        License
      </h2>
      <p class="text-(--text-secondary)">
        Seamap is derived from
        <a
          href="https://www.openstreetmap.org/copyright"
          target="_blank"
          rel="noopener noreferrer"
          class="text-(--accent) hover:text-(--accent-hover)"
          >© OpenStreetMap contributors</a
        > data, available under the Open Database License (ODbL). Attribution is included
        in the TileJSON, so map libraries credit OSM automatically.
      </p>
    </div>
  </Container>
</MainLayout>
