---
import { slackwaterLink } from "../utils/slackwater-link";
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";

const GH = "https://github.com/openwatersio";

interface Row {
  project: string;
  href: string;
  code: string;
  data: string;
  service: string;
}

// Each row restates the project's LICENSE and README. Other pages state
// project licenses too: public/llms.txt, about, ais/, charts/, tides/slackwater,
// sky, and the MIT schema in utils/schema.ts. When a project changes its
// license, search the site for it.
const projects: Row[] = [
  {
    project: "Slackwater engine and CLI",
    href: `${GH}/slackwater`,
    code: "MIT",
    data: "None of its own. It reads station data from the database.",
    service: "None. Runs where you install it.",
  },
  {
    project: "Tide and current database",
    href: `${GH}/slackwater-database`,
    code: "MIT",
    data: "Per station, from its source: public domain, CC BY 4.0, Japan's Government Standard Terms of Use 2.0, or CC BY-NC 4.0 (non-commercial). The bundled OpenStreetMap coastline and water bodies are ODbL, and the GeoNames places and Marine Regions zones are CC BY 4.0.",
    service:
      "Tides and Currents API: free, no key, 100 requests a minute and 10,000 a day per IP. Each station record carries its license. Canadian current stations return HTTP 451.",
  },
  {
    project: "Slackwater for iOS and Android",
    href: slackwaterLink("/", "license"),
    code: "GPL-3.0. Contributions to the iOS app need the CLA.",
    data: "Bundled station data keeps its license from the database.",
    service: "None beyond the APIs the app calls.",
  },
  {
    project: "Open Waters AIS (aiscast)",
    href: `${GH}/aiscast`,
    code: "AGPL-3.0 with a CLA. The Signal K plugin is MIT, and releases before the switch stay MIT.",
    data: "Volunteer receptions are CC0 and the volunteer aggregate is ODbL. Other sources keep their own terms, named on every event.",
    service:
      "Free without a token, with limits. A free personal token raises them; feeding a receiver earns the contributor tier. A paid Commercial tier is arranged by email.",
  },
  {
    project: "Seamap",
    href: `${GH}/seamap`,
    code: "GPL-3.0. The @openwaters/seamap style package is MIT, apart from its chart symbols, which are used with permission. Code inherited from prozessor13/seamap stays MIT.",
    data: "Tiles are ODbL: they carry OpenStreetMap features.",
    service:
      "tiles.openwaters.io/seamap: free, with the attribution on the chart's page. Not for navigation.",
  },
  {
    project: "Seascape",
    href: `${GH}/seascape`,
    code: "BSD-3-Clause",
    data: "The compilation is ODbL: OpenStreetMap land polygons shape it. Each bathymetry source keeps its own terms, and some forbid resale.",
    service:
      "tiles.openwaters.io/seascape: free, with the attribution on the chart's page. Not for navigation.",
  },
  {
    project: "Stillwell water levels",
    href: `${GH}/stillwell`,
    code: "AGPL-3.0 with a CLA",
    data: "CC BY 4.0. Stations marked non-commercial keep their source's terms.",
    service: "Parquet files at stillwell.openwaters.io, free.",
  },
  {
    project: "Crowd Depth",
    href: `${GH}/crowd-depth`,
    code: "MIT",
    data: "Collected soundings are CC0.",
    service: "None. A Signal K plugin you run.",
  },
  {
    project: "Almanac",
    href: `${GH}/almanac`,
    code: "MIT",
    data: "None",
    service: "None. Computes offline.",
  },
  {
    project: "Open Waters app",
    href: `${GH}/OpenWaters`,
    code: "GPL-3.0 with a CLA",
    data: "Charts and data keep their sources' licenses.",
    service: "None",
  },
  {
    project: "Maritime zones",
    href: `${GH}/maritime-zones`,
    code: "MIT",
    data: "CC BY 4.0, from the Flanders Marine Institute.",
    service: "None",
  },
  {
    project: "Chart catalog",
    href: `${GH}/chart-catalog`,
    code: "MIT",
    data: "Each chart collection keeps its source's license.",
    service: "None",
  },
  {
    project: "openwaters.io and slackwater.xyz",
    href: `${GH}/openwaters.io`,
    code: "MIT",
    data: "Written content is CC BY 4.0. Data shown on the sites keeps its own license.",
    service: "None",
  },
];

// Small projects whose single license covers everything in them.
const others = [
  { name: "coordinate-format", license: "MIT" },
  { name: "c5y-n8r", license: "MIT" },
  { name: "homebrew-tap", license: "MIT" },
  { name: "enc-tiles", license: "Apache-2.0" },
  { name: "signalk-tides", license: "Apache-2.0" },
  { name: "tile-fonts", license: "OFL-1.1 fonts, BSD-3-Clause for the rest" },
  { name: "tippecanoe", license: "BSD-2-Clause" },
  { name: "xtide", license: "MIT build files; XTide is GPL-3.0" },
  { name: "stillwell-notebooks", license: "AGPL-3.0" },
  { name: "nightwatch-ios", license: "CC BY 4.0" },
];
---

<MainLayout
  title="License"
  description="How each Open Waters project licenses its code, its data, and its hosted service."
>
  <Container class="py-16">
    <div class="mx-auto max-w-5xl">
      <h1 class="mb-8">License</h1>

      <div class="prose prose-lg mb-12 max-w-none">
        <p class="text-fg-muted text-xl">
          Every Open Waters project is open source, and the data we make is
          open. Code, data, and hosted services are licensed separately, and the
          answer differs by project, so the table lists each one.
        </p>
      </div>

      <div class="border-line overflow-x-auto rounded-2xl border">
        <table class="w-full min-w-3xl text-sm">
          <thead class="border-line bg-surface text-fg-faint border-b text-[11px] font-medium tracking-[0.12em] uppercase">
            <tr>
              <th scope="col" class="px-4 py-3 text-left font-medium">
                Project
              </th>
              <th scope="col" class="px-4 py-3 text-left font-medium">
                Code
              </th>
              <th scope="col" class="px-4 py-3 text-left font-medium">
                Data
              </th>
              <th scope="col" class="px-4 py-3 text-left font-medium">
                Hosted service
              </th>
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {projects.map((row) => (
              <tr class="align-top">
                <th
                  scope="row"
                  class="text-fg-strong px-4 py-3 text-left font-medium"
                >
                  <a href={row.href}>{row.project}</a>
                </th>
                {/* The Markdown copy of this page has no tables, so each cell
                    names its column for agents and screen readers. */}
                <td class="text-fg-muted px-4 py-3">
                  <span class="sr-only">Code: </span>
                  {row.code}
                </td>
                <td class="text-fg-muted px-4 py-3">
                  <span class="sr-only">Data: </span>
                  {row.data}
                </td>
                <td class="text-fg-muted px-4 py-3">
                  <span class="sr-only">Hosted service: </span>
                  {row.service}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-fg-muted mt-6">
        Smaller projects carry one license for everything in them:{" "}
        {others.map((o, i) => (
          <>
            <a href={`${GH}/${o.name}`}>{o.name}</a> ({o.license})
            {i < others.length - 1 ? ", " : "."}
          </>
        ))}
      </p>

      <p class="text-fg-muted mt-4 text-sm">
        Each repository's LICENSE file and README are the authoritative terms.
        This page summarizes them.
      </p>

      <div class="mt-12 space-y-8">
        <Card>
          <h2 class="mb-3 text-2xl font-semibold">What the licenses mean</h2>
          <ul class="text-fg-muted space-y-3">
            <li>
              <strong class="text-fg-strong">MIT, Apache-2.0, BSD:</strong> use,
              change, and ship the code for any purpose, commercial included, as
              long as the license notice stays with it.
            </li>
            <li>
              <strong class="text-fg-strong">GPL-3.0 and AGPL-3.0:</strong> the
              same freedoms, but a modified copy you distribute must stay under
              the same license with its source available. AGPL extends that to a
              modified copy that people use over a network.
            </li>
            <li>
              <strong class="text-fg-strong">CC0 and public domain:</strong> no
              conditions at all.
            </li>
            <li>
              <strong class="text-fg-strong">CC BY 4.0:</strong> any use,
              commercial included, with attribution.
            </li>
            <li>
              <strong class="text-fg-strong">ODbL:</strong> any use, commercial
              included, with attribution. A database you derive from it and
              publish has to be ODbL too. Maps and images rendered from it need
              the attribution, and if you rendered them from a database you
              changed, you offer that database as well. Sources inside an ODbL
              compilation can add limits of their own, such as no resale.
            </li>
            <li>
              <strong class="text-fg-strong">CC BY-NC 4.0:</strong> attribution,
              and no commercial use. API records and the database mark these
              stations so you can leave them out.
            </li>
          </ul>
        </Card>

        <Card>
          <h2 class="mb-3 text-2xl font-semibold">Attribution</h2>
          <p class="text-fg-muted mb-4">
            Data licenses other than CC0 and public domain require attribution.
            Wherever you show the data, show the credit that comes with it:
          </p>
          <ul class="text-fg-muted space-y-2">
            <li>
              Tide and current station records carry an <code>attribution</code>{" "}
              for their source.
            </li>
            <li>
              Open Waters AIS names the source on every event, and its{" "}
              <code>/v1</code> API adds the source's <code>attribution</code>{" "}
              line.
            </li>
            <li>
              The <a href="/charts/seamap/#license">Seamap</a> and{" "}
              <a href="/charts/seascape/#license">Seascape</a> pages give the
              attribution line for their tiles. MapLibre's attribution control
              displays the credits their styles carry.
            </li>
          </ul>
        </Card>

        <Card>
          <h2 class="mb-3 text-2xl font-semibold">Copyright and names</h2>
          <p class="text-fg-muted mb-4">
            Open Waters is operated by Open Water Software, LLC, which holds the
            copyright in its own work. Projects that started elsewhere keep
            their original authors' notices beside it. Contributors keep the
            copyright in their contributions. Projects with a CLA also grant
            Open Water Software, LLC the rights it needs to ship them, such as
            putting a GPL app on the App Store.
          </p>
          <p class="text-fg-muted">
            The licenses cover code and data. They don't cover the Open Waters,
            Slackwater, or project names and logos.
          </p>
        </Card>

        <Card class="border-line bg-surface">
          <div class="text-center">
            <h2 class="mb-3 text-2xl font-semibold">
              Questions about licensing
            </h2>
            <p class="text-fg-muted mb-6 text-balance">
              Ask us about a use that isn't clear, or about commercial access to
              a hosted service.
            </p>
            <a href="/contact/" class="btn btn-primary">
              Contact us
            </a>
          </div>
        </Card>
      </div>
    </div>
  </Container>
</MainLayout>
