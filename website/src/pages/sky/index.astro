---
import MainLayout from "../../layouts/MainLayout.astro";
import { softwareSourceCode } from "../../utils/schema";
import Container from "../../components/ui/Container.astro";
import Card from "../../components/ui/Card.astro";
import CodeBlock from "../../components/ui/CodeBlock.astro";
import Icon from "../../components/Icon.astro";
import SkyDome from "../../components/sky/SkyDome";
import { MoonFilmstrip, TwilightRibbon } from "../../components/sky/SkyDemos";

import SunYear from "../../components/sky/SunYear";
import LunarEclipseDemo from "../../components/sky/LunarEclipseDemo";

const REPO = "https://github.com/openwatersio/almanac";
const ROADMAP = `${REPO}/blob/main/docs/ROADMAP.md`;
const VERSION = "0.2.1";
const initialMonth = new Date().toISOString().slice(0, 7);
const moonCode = `import { moonIllumination, searchMoonPhases } from '@openwaters/almanac';

const start = new Date('2026-09-01T00:00:00Z');
const end = new Date('2026-10-01T00:00:00Z');
const days = Array.from({ length: 30 }, (_, day) => {
  const time = new Date(start.getTime() + (day + 0.5) * 86_400_000);
  return { time, ...moonIllumination(time) };
});

// Each disc uses fraction (0–1) and waxing (bright side).
// These are the exact instants for the four phase buttons.
const quarters = searchMoonPhases(start, end);
console.log(days, quarters);`;
const twilightCode = `import { sunEvents, sunAltAz } from '@openwaters/almanac';

const observer = { latitudeDeg: 70, longitudeDeg: 0 };
const start = new Date('2026-06-21T00:00:00Z');
const end = new Date('2026-06-22T00:00:00Z');
const crossings = sunEvents(start, end, observer)
  .filter(event => event.kind !== 'transit');

// Use each crossing time as a color boundary in the 24-hour ribbon.
// Dawn enters a lighter band; dusk enters a darker one.
// No crossings? Check altitude: midnight Sun is not a missing result.
console.log(crossings, sunAltAz(start, observer).altDeg);`;

const features = [
  {
    icon: "mdi:wifi-off",
    title: "Offline by construction",
    body: "Zero network calls and zero runtime data files. Everything on this page is computed in your browser from pure geometry — the same code runs on a boat with no signal.",
  },
  {
    icon: "mdi:call-split",
    title: "Twin ports, one behavior",
    body: "TypeScript and Swift implementations validated against a shared corpus of JPL Horizons, USNO and Espenak fixtures. Neither port is the other's oracle.",
  },
  {
    icon: "mdi:weather-night",
    title: "Sun, Moon and eclipses",
    body: "Positions, rise and set, all three twilights, transit, moon phase and illumination, and lunar eclipses with contact times and local visibility.",
  },
  {
    icon: "mdi:target",
    title: "Held to a tolerance",
    body: "Rise and set times agree with USNO to within a minute across 1950–2100, and eclipse peaks match the Espenak catalog to roughly 15 seconds.",
  },
];

const tsCode = `import { sunEvents, nextLunarEclipse, lunarEclipseVisibility } from '@openwaters/almanac';

const observer = { latitudeDeg: 48.5, longitudeDeg: -123.0 };

// Sunrise, sunset, twilights and transit for the next 24 hours
const now = new Date();
const tomorrow = new Date(now.getTime() + 24 * 60 * 60 * 1000);
for (const { kind, time } of sunEvents(now, tomorrow, observer)) {
  console.log(kind, time.toISOString());
}

// The next lunar eclipse, and whether you'll see it
const eclipse = nextLunarEclipse(now);
const visibility = lunarEclipseVisibility(eclipse, observer);
console.log(eclipse.kind, eclipse.peak, visibility.visibleAtPeak);`;

const swiftCode = `import Almanac
import Foundation

let observer = try Observer(latitudeDeg: 48.5, longitudeDeg: -123.0)

let now = Date()
let tomorrow = now.addingTimeInterval(24 * 60 * 60)
for event in try sunEvents(from: now, to: tomorrow, observer: observer) {
  print(event.kind, event.time)
}

let eclipse = try nextLunarEclipse(after: now)
let visibility = try lunarEclipseVisibility(eclipse, observer: observer)
print(eclipse.kind, eclipse.peak, visibility.visibleAtPeak)`;
---

<MainLayout
  title="Sky"
  description="Explore an interactive sky, Moon phase filmstrip and daylight/twilight ribbon. Almanac computes Sun, Moon and lunar eclipses offline in Swift and TypeScript, with code examples."
  image="/og/sky.png"
  schema={softwareSourceCode({
    name: "Almanac",
    description:
      "An offline sun and moon engine for Swift and TypeScript: positions, rise and set, twilight, transit, moon phase, and lunar eclipses, computed from pure geometry with no network.",
    path: "/sky/",
    codeRepository: "https://github.com/openwatersio/almanac",
    programmingLanguage: ["Swift", "TypeScript"],
  })}
>
  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-(--accent)">
            <Icon name="mdi:weather-sunset-up" class="size-10" />
          </span>
          <h1 class="mb-0">Almanac</h1>
        </div>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline inline-flex items-center gap-2"
        >
          <Icon name="mdi:github" class="size-6" />
          View on GitHub
        </a>
      </div>

      <div class="text-lead mt-2 mb-4">
        An offline sun &amp; moon engine for Swift and TypeScript
      </div>

      <div class="prose prose-xl mb-10 max-w-none">
        <p>
          Where the Sun and Moon are, when they rise and set, how the Moon is
          lit, and when the Earth's shadow crosses it. No network, no data files
          to ship, no API key — just geometry, in your app or on your boat. The
          sky below is live: it is this library running in your browser right
          now.
        </p>
      </div>

      <SkyDome client:only="react">
        <div slot="fallback" class="space-y-6">
          <div
            class="aspect-2/1 w-full animate-pulse rounded-xl bg-(--surface-subtle)"
          >
          </div>
          <div class="h-6 w-full animate-pulse rounded bg-(--surface-subtle)">
          </div>
        </div>
      </SkyDome>

      <section
        id="moon-filmstrip"
        aria-labelledby="moon-filmstrip-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <div>
          <h2 id="moon-filmstrip-title" class="mb-3 text-3xl font-semibold">
            A month of Moon
          </h2>
          <p class="text-(--text-secondary)">
            Watch a crescent grow into a full Moon and fade again. Choose a
            month, tap a disc or scrub through the days to explore the Moon's
            phase and illumination.
          </p>
        </div>
        <MoonFilmstrip initialMonth={initialMonth} client:load />
        <details>
          <summary class="cursor-pointer font-medium text-(--accent)"
            >Show the TypeScript</summary
          >
          <CodeBlock code={moonCode} class="mt-4" />
        </details>
      </section>

      <section
        id="twilight-ribbon"
        aria-labelledby="twilight-ribbon-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <div>
          <h2 id="twilight-ribbon-title" class="mb-3 text-3xl font-semibold">
            Where night disappears
          </h2>
          <p class="text-(--text-secondary)">
            A full day, from sunlight through civil, nautical and astronomical
            twilight into night. Change latitude and season to find the midnight
            Sun—or a day when the Sun never rises.
          </p>
        </div>
        <TwilightRibbon client:load />
        <details>
          <summary class="cursor-pointer font-medium text-(--accent)"
            >Show the TypeScript</summary
          >
          <CodeBlock code={twilightCode} class="mt-4" />
        </details>
      </section>

      <p class="mt-8 text-(--text-secondary)">
        The same astronomy engine powers <a
          href="https://slackwater.xyz/"
          class="font-medium text-(--accent) underline-offset-4 hover:underline"
          >Slackwater's Sun and Moon views</a
        >, with Moon illumination and sunrise/sunset alongside the tide
        timeline.
      </p>

      <section
        id="sun-year"
        aria-labelledby="sun-year-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <h2 id="sun-year-title" class="text-3xl font-semibold">
          A year of the Sun
        </h2>
        <SunYear client:load />
        <details>
          <summary class="cursor-pointer font-medium text-(--accent)"
            >Show the TypeScript</summary
          >
          <CodeBlock
            class="mt-4"
            code={`import { sunAltAz } from '@openwaters/almanac';

const observer = { latitudeDeg: 48.5, longitudeDeg: -123 };
const points = Array.from({ length: 365 }, (_, day) => {
  // A fixed UTC time near local mean noon, independent of daylight saving.
  const time = new Date(Date.UTC(2026, 0, day + 1, 12)
    - observer.longitudeDeg / 360 * 86_400_000);
  return { time, ...sunAltAz(time, observer) };
});
console.log(points);`}
          />
        </details>
      </section>
      <section
        id="lunar-eclipses"
        aria-labelledby="lunar-eclipses-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <h2 id="lunar-eclipses-title" class="text-3xl font-semibold">
          The Moon in Earth's shadow
        </h2>
        <p class="text-(--text-secondary)">
          Explore penumbral, partial and total lunar eclipses with real examples
          from 2026–2027. Scrub across each event to see what changes on the
          Moon itself.
        </p>
        <LunarEclipseDemo client:load />
        <details>
          <summary class="cursor-pointer font-medium text-(--accent)"
            >Show the TypeScript</summary
          >
          <CodeBlock
            class="mt-4"
            code={`import { lunarEclipses, lunarEclipseVisibility } from '@openwaters/almanac';

const eclipses = lunarEclipses(
  new Date('2026-01-01T00:00:00Z'),
  new Date('2028-01-01T00:00:00Z'),
);
const observer = { latitudeDeg: 48.5, longitudeDeg: -123 };
for (const eclipse of eclipses) {
  console.log(eclipse.kind, eclipse.peak,
    lunarEclipseVisibility(eclipse, observer));
}`}
          />
        </details>
      </section>

      <!-- Key Features -->
      <div class="mt-16 mb-16">
        <h2 class="mb-6 text-3xl font-semibold">Key Features</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            features.map((feature) => (
              <Card>
                <div class="flex items-start gap-3">
                  <div class="text-(--accent)">
                    <Icon name={feature.icon} class="size-8" />
                  </div>
                  <div>
                    <h3 class="mb-2 text-lg font-semibold">{feature.title}</h3>
                    <p class="text-sm text-(--text-secondary)">
                      {feature.body}
                    </p>
                  </div>
                </div>
              </Card>
            ))
          }
        </div>
      </div>

      <!-- Usage -->
      <div class="mb-16">
        <h2 class="mb-6 text-3xl font-semibold">Using Almanac</h2>
        <Card>
          <div class="space-y-6">
            <div>
              <h3 class="mb-3 text-xl font-semibold">TypeScript</h3>
              <CodeBlock
                code={`npm install @openwaters/almanac@${VERSION}`}
                class="mb-3"
              />
              <CodeBlock code={tsCode} />
            </div>

            <div>
              <h3 class="mb-3 text-xl font-semibold">Swift</h3>
              <CodeBlock
                code={`.package(url: "${REPO}.git", exact: "${VERSION}")`}
                class="mb-3"
              />
              <CodeBlock code={swiftCode} />
            </div>
          </div>
        </Card>
        <p class="mt-4 text-sm text-(--text-secondary)">
          Supported interval: 1950-01-01 through 2100-12-31. Where the library
          is going next is written down in the <a
            href={ROADMAP}
            class="text-(--accent) hover:underline">roadmap</a
          >.
        </p>
      </div>

      <!-- Open Source -->
      <Card
        class="from-ocean-600 to-ocean-700 border-0 bg-linear-to-r text-white"
      >
        <div class="text-center">
          <h2 class="mb-4 text-3xl font-semibold text-white">
            Free &amp; Open Source
          </h2>
          <p class="text-ocean-50 mb-6 text-xl text-balance">
            Almanac is MIT licensed, with its astronomy translated from Don
            Cross's Astronomy Engine. Use it, contribute to it, or fork it.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={REPO}
              target="_blank"
              rel="noopener noreferrer"
              class="btn text-ocean-700 hover:bg-ocean-50 bg-white"
            >
              <Icon name="mdi:github" class="size-6" />
              View on GitHub
            </a>
            <a href={ROADMAP} class="btn btn-outline border-white text-white">
              Roadmap
            </a>
          </div>
        </div>
      </Card>
    </div>
  </Container>
</MainLayout>
