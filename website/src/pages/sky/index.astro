---
import MainLayout from "../../layouts/MainLayout.astro";
import { softwareSourceCode } from "../../utils/schema";
import Container from "../../components/ui/Container.astro";
import Card from "../../components/ui/Card.astro";
import CodeBlock from "../../components/ui/CodeBlock.astro";
import Icon from "../../components/Icon.astro";
import SkyDome from "../../components/sky/SkyDome";

const REPO = "https://github.com/openwatersio/almanac";
const ROADMAP = `${REPO}/blob/main/docs/ROADMAP.md`;
const VERSION = "0.5.0";
const explore = [
  {
    href: "/sky/sun/",
    icon: "mdi:white-balance-sunny",
    title: "Sun",
    body: "Twilight from the equator to the midnight Sun, a year of the Sun's path, solar eclipses from your location, and every solar eclipse on Earth with its central line.",
    cta: "Explore the Sun",
  },
  {
    href: "/sky/moon/",
    icon: "mdi:moon-waning-crescent",
    title: "Moon",
    body: "A month of phases and illumination, and lunar eclipses as the Earth's shadow crosses the Moon.",
    cta: "Explore the Moon",
  },
];

const features = [
  {
    icon: "mdi:wifi-off",
    title: "Offline by construction",
    body: "Zero network calls and zero runtime data files. Every Sun, Moon, star and eclipse on these pages is computed in your browser from pure geometry; only the map tiles behind the eclipse paths are downloaded. The same code runs on a boat with no signal.",
  },
  {
    icon: "mdi:call-split",
    title: "Twin ports, one behavior",
    body: "TypeScript and Swift implementations validated against a shared corpus of JPL Horizons, USNO and Espenak fixtures. Neither port is the other's oracle.",
  },
  {
    icon: "mdi:weather-night",
    title: "Sun, Moon, stars and eclipses",
    body: "Positions, rise and set, all three twilights, transit, moon phase and illumination, lunar and local solar eclipses with contact times, every solar eclipse on Earth with its central line, and alt/az for any star you give a catalog position.",
  },
  {
    icon: "mdi:target",
    title: "Held to a tolerance",
    body: "Rise and set times agree with USNO to within a minute across 1950–2100, and eclipse peaks match the Espenak catalog to roughly 15 seconds.",
  },
];

const tsCode = `import { sunEvents, starAltAz, nextLunarEclipse, lunarEclipseVisibility, nextSolarEclipse, nextGlobalSolarEclipse } from '@openwaters/almanac';

const observer = { latitudeDeg: 48.5, longitudeDeg: -123.0 };

// Sunrise, sunset, twilights and transit for the next 24 hours
const now = new Date();
const tomorrow = new Date(now.getTime() + 24 * 60 * 60 * 1000);
for (const { kind, time } of sunEvents(now, tomorrow, observer)) {
  console.log(kind, time.toISOString());
}

// The next lunar eclipse, and whether you'll see it
const eclipse = nextLunarEclipse(now);
const visibility = lunarEclipseVisibility(eclipse, observer);
console.log(eclipse.kind, eclipse.peak, visibility.visibleAtPeak);

// The next solar eclipse visible from this location
const solar = nextSolarEclipse(now, observer);
console.log(solar.kind, solar.peak, solar.obscuration);

// The next solar eclipse anywhere on Earth, and where its shadow axis lands
const anywhere = nextGlobalSolarEclipse(now);
console.log(anywhere.kind, anywhere.peak, anywhere.latitudeDeg, anywhere.longitudeDeg);

// Where Sirius is right now, from its J2000 catalog position
console.log(starAltAz(101.287, -16.716, now, observer));`;

const swiftCode = `import Almanac
import Foundation

let observer = try Observer(latitudeDeg: 48.5, longitudeDeg: -123.0)

let now = Date()
let tomorrow = now.addingTimeInterval(24 * 60 * 60)
for event in try sunEvents(from: now, to: tomorrow, observer: observer) {
  print(event.kind, event.time)
}

let eclipse = try nextLunarEclipse(after: now)
let visibility = try lunarEclipseVisibility(eclipse, observer: observer)
print(eclipse.kind, eclipse.peak, visibility.visibleAtPeak)

let solar = try nextSolarEclipse(after: now, observer: observer)
print(solar.kind, solar.peak, solar.obscuration)

let anywhere = try nextGlobalSolarEclipse(after: now)
if let latitude = anywhere.latitudeDeg, let longitude = anywhere.longitudeDeg {
  print(anywhere.kind, anywhere.peak, latitude, longitude)
}

let sirius = try starAltAz(raDeg: 101.287, decDeg: -16.716, at: now, observer: observer)
print(sirius.altDeg, sirius.azDeg)`;
---

<MainLayout
  title="Sky"
  description="Explore a live star field for your own location, then the Sun and Moon: twilight, phases and eclipses. Almanac computes the Sun, Moon, stars, and lunar and solar eclipses offline in Swift and TypeScript."
  image="/og/sky.png"
  schema={softwareSourceCode({
    name: "Almanac",
    description:
      "An offline celestial engine for Swift and TypeScript: Sun and Moon positions, rise and set, twilight, transit, moon phase, lunar and solar eclipses, and alt/az for any catalog star, computed from pure geometry with no network.",
    path: "/sky/",
    codeRepository: "https://github.com/openwatersio/almanac",
    programmingLanguage: ["Swift", "TypeScript"],
  })}
>
  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-accent">
            <Icon name="mdi:weather-sunset-up" class="size-10" />
          </span>
          <h1 class="mb-0">Almanac</h1>
        </div>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary inline-flex items-center gap-2"
        >
          <Icon name="mdi:github" class="size-6" />
          View on GitHub
        </a>
      </div>

      <div class="text-lead mt-2 mb-4">
        An offline sky engine for Swift and TypeScript
      </div>

      <div class="prose prose-xl mb-10 max-w-none">
        <p>
          Where the Sun, Moon and stars are, when they rise and set, how the
          Moon is lit, when the Earth's shadow crosses it, and when the Moon
          crosses the Sun from your location. No network, no data files to ship,
          no API key — just geometry, in your app or on your boat. The sky below
          is live: every star in it is this library running in your browser,
          placed for your location and the moment you choose. The Sun and Moon
          pages have more to explore.
        </p>
      </div>

      <SkyDome client:only="react">
        <div slot="fallback" class="space-y-6">
          <div
            class="bg-surface mx-auto aspect-square w-full max-w-[34rem] animate-pulse rounded-full"
          >
          </div>
          <div class="bg-surface h-6 w-full animate-pulse rounded"></div>
        </div>
      </SkyDome>

      <!-- Demos -->
      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          explore.map((card) => (
            <Card href={card.href} class="space-y-3">
              <div class="text-accent">
                <Icon name={card.icon} class="size-12" />
              </div>
              <h2 class="text-3xl md:text-4xl">{card.title}</h2>
              <p class="text-fg-muted">{card.body}</p>
              <span class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium">
                {card.cta}
                <svg
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </span>
            </Card>
          ))
        }
      </div>

      <p class="text-fg-muted mt-8">
        The same astronomy engine powers <a
          href="https://slackwater.xyz/"
          class="text-accent font-medium underline-offset-4 hover:underline"
          >Slackwater's Sun and Moon views</a
        >, with Moon illumination and sunrise/sunset alongside the tide
        timeline.
      </p>

      <!-- Key Features -->
      <div class="mt-16 mb-16">
        <h2 class="mb-6 text-3xl font-semibold">Key Features</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            features.map((feature) => (
              <Card>
                <div class="flex items-start gap-3">
                  <div class="text-accent">
                    <Icon name={feature.icon} class="size-8" />
                  </div>
                  <div>
                    <h3 class="mb-2 text-lg font-semibold">{feature.title}</h3>
                    <p class="text-fg-muted text-sm">{feature.body}</p>
                  </div>
                </div>
              </Card>
            ))
          }
        </div>
      </div>

      <!-- Usage -->
      <div class="mb-16">
        <h2 class="mb-6 text-3xl font-semibold">Using Almanac</h2>
        <Card>
          <div class="space-y-6">
            <div>
              <h3 class="mb-3 text-xl font-semibold">TypeScript</h3>
              <CodeBlock
                code={`npm install @openwaters/almanac@${VERSION}`}
                class="mb-3"
              />
              <CodeBlock code={tsCode} />
            </div>

            <div>
              <h3 class="mb-3 text-xl font-semibold">Swift</h3>
              <CodeBlock
                code={`.package(url: "${REPO}.git", exact: "${VERSION}")`}
                class="mb-3"
              />
              <CodeBlock code={swiftCode} />
            </div>
          </div>
        </Card>
        <p class="text-fg-muted mt-4 text-sm">
          Supported interval: 1950-01-01 through 2100-12-31. Where the library
          is going next is written down in the <a
            href={ROADMAP}
            class="text-accent hover:underline">roadmap</a
          >.
        </p>
      </div>

      <!-- Open Source -->
      <Card class="">
        <div class="text-center">
          <h2 class="text-fg-strong mb-4 text-3xl font-semibold">
            Free &amp; Open Source
          </h2>
          <p class="text-fg-muted mb-6 text-xl text-balance">
            Almanac is MIT licensed, with its astronomy translated from Don
            Cross's Astronomy Engine. Use it, contribute to it, or fork it.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={REPO}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <Icon name="mdi:github" class="size-6" />
              View on GitHub
            </a>
            <a href={ROADMAP} class="btn btn-secondary"> Roadmap </a>
          </div>
        </div>
      </Card>
    </div>
  </Container>
</MainLayout>
