---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/ui/Container.astro";
import CodeBlock from "../../components/ui/CodeBlock.astro";
import Icon from "../../components/Icon.astro";
import { TwilightRibbon } from "../../components/sky/SkyDemos";
import SunYear from "../../components/sky/SunYear";
import SolarEclipseDemo from "../../components/sky/SolarEclipseDemo";
import GlobalSolarEclipseDemo from "../../components/sky/GlobalSolarEclipseDemo";

const twilightCode = `import { sunEvents, sunAltAz } from '@openwaters/almanac';

const observer = { latitudeDeg: 70, longitudeDeg: 0 };
const start = new Date('2026-06-21T00:00:00Z');
const end = new Date('2026-06-22T00:00:00Z');
const crossings = sunEvents(start, end, observer)
  .filter(event => event.kind !== 'transit');

// Use each crossing time as a color boundary in the 24-hour ribbon.
// Dawn enters a lighter band; dusk enters a darker one.
// No crossings? Check altitude: midnight Sun is not a missing result.
console.log(crossings, sunAltAz(start, observer).altDeg);`;
const solarCode = `import { solarEclipses, solarObscuration } from '@openwaters/almanac';

const observer = { latitudeDeg: 48.5, longitudeDeg: -123 };
const start = new Date();
const end = new Date(start);
end.setUTCFullYear(end.getUTCFullYear() + 10);

for (const eclipse of solarEclipses(start, end, observer)) {
  console.log(eclipse.kind, eclipse.peak, eclipse.obscuration);
  console.log(solarObscuration(eclipse.peak, observer));
}`;
const globalCode = `import { globalSolarEclipses, solarEclipseCentralLine } from '@openwaters/almanac';

const start = new Date();
const end = new Date(start);
end.setUTCFullYear(end.getUTCFullYear() + 10);

// No observer: every solar eclipse on Earth, with where greatest eclipse
// falls. For a partial, whose shadow axis misses the Earth, that is the point
// on the Earth's edge nearest the axis, with the Sun on the horizon.
for (const eclipse of globalSolarEclipses(start, end)) {
  console.log(eclipse.kind, eclipse.peak, eclipse.greatestLatitudeDeg,
    eclipse.greatestLongitudeDeg, eclipse.greatestObscuration);

  // The central line, one point a minute, each total or annular.
  const line = solarEclipseCentralLine(eclipse.peak);
  console.log(line.map(({ time, latitudeDeg, longitudeDeg, kind }) =>
    [time, latitudeDeg, longitudeDeg, kind]));
}`;
---

<MainLayout
  title="Sun · Almanac"
  description="Explore twilight from the equator to the midnight Sun, a year of the Sun's path, solar eclipses from your location, and every solar eclipse on Earth with its central line, computed offline by Almanac."
  image="/og/sun.png"
>
  <Container class="py-16">
    <div class="mx-auto max-w-4xl">
      <a
        href="/sky/"
        class="text-accent hover:text-accent-hover inline-flex items-center gap-1 font-medium"
      >
        <Icon name="mdi:chevron-left" class="size-5" />
        Almanac
      </a>
      <div class="mt-4 flex items-center gap-3">
        <span class="text-accent">
          <Icon name="mdi:white-balance-sunny" class="size-10" />
        </span>
        <h1 class="mb-0">Sun</h1>
      </div>

      <div class="text-lead mt-2 mb-4">
        Twilight, the Sun's year, and solar eclipses
      </div>

      <div class="prose prose-xl mb-10 max-w-none">
        <p>
          Where the Sun is, when it rises and sets, how deep each twilight runs,
          and when the Moon crosses it, from your location or anywhere on Earth.
          Every demo here is Almanac running in your browser.
        </p>
      </div>

      <section
        id="twilight-ribbon"
        aria-labelledby="twilight-ribbon-title"
        class="mt-6 scroll-mt-24 space-y-6"
      >
        <div>
          <h2 id="twilight-ribbon-title" class="mb-3 text-3xl font-semibold">
            Where night disappears
          </h2>
          <p class="text-fg-muted">
            A full day, from sunlight through civil, nautical and astronomical
            twilight into night. Change latitude and season to find the midnight
            Sun—or a day when the Sun never rises.
          </p>
        </div>
        <TwilightRibbon client:load />
        <details>
          <summary class="text-accent cursor-pointer font-medium"
            >Show the TypeScript</summary
          >
          <CodeBlock code={twilightCode} class="mt-4" />
        </details>
      </section>
      <section
        id="sun-year"
        aria-labelledby="sun-year-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <h2 id="sun-year-title" class="text-3xl font-semibold">
          A year of the Sun
        </h2>
        <SunYear client:load />
        <details>
          <summary class="text-accent cursor-pointer font-medium"
            >Show the TypeScript</summary
          >
          <CodeBlock
            class="mt-4"
            code={`import { sunAltAz } from '@openwaters/almanac';

const observer = { latitudeDeg: 48.5, longitudeDeg: -123 };
const points = Array.from({ length: 365 }, (_, day) => {
  // A fixed UTC time near local mean noon, independent of daylight saving.
  const time = new Date(Date.UTC(2026, 0, day + 1, 12)
    - observer.longitudeDeg / 360 * 86_400_000);
  return { time, ...sunAltAz(time, observer) };
});
console.log(points);`}
          />
        </details>
      </section>
      <section
        id="solar-eclipses"
        aria-labelledby="solar-eclipses-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <h2 id="solar-eclipses-title" class="text-3xl font-semibold">
          Solar eclipses from here
        </h2>
        <p class="text-fg-muted">
          A solar eclipse is a different event from every place: your location
          determines which eclipses appear, their contact times, and how much of
          the Sun the Moon covers. A solar eclipse is the Moon's shadow falling
          on the Earth; the Earth's shadow falling on the Moon is a <a
            href="/sky/moon/#lunar-eclipses"
            class="text-accent font-medium underline-offset-4 hover:underline"
            >lunar eclipse</a
          >.
        </p>
        <SolarEclipseDemo client:only="react">
          <div
            slot="fallback"
            class="bg-surface h-96 w-full animate-pulse rounded-xl"
          >
          </div>
        </SolarEclipseDemo>
        <details>
          <summary class="text-accent cursor-pointer font-medium"
            >Show the TypeScript</summary
          >
          <CodeBlock code={solarCode} class="mt-4" />
        </details>
      </section>
      <section
        id="eclipses-anywhere"
        aria-labelledby="eclipses-anywhere-title"
        class="mt-16 scroll-mt-24 space-y-6"
      >
        <h2 id="eclipses-anywhere-title" class="text-3xl font-semibold">
          Solar eclipses anywhere on Earth
        </h2>
        <p class="text-fg-muted">
          A few recent solar eclipses, and every one in the next ten years,
          wherever it happens, marked where greatest eclipse falls. For a total
          or annular eclipse, follow the Moon's shadow along its central line
          from where it first touches the Earth to where it leaves.
        </p>
        <GlobalSolarEclipseDemo client:only="react">
          <div
            slot="fallback"
            class="bg-surface aspect-square w-full animate-pulse rounded-xl md:w-1/2"
          >
          </div>
        </GlobalSolarEclipseDemo>
        <details>
          <summary class="text-accent cursor-pointer font-medium"
            >Show the TypeScript</summary
          >
          <CodeBlock code={globalCode} class="mt-4" />
        </details>
      </section>
    </div>
  </Container>
</MainLayout>
