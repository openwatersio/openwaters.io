---
import Icon from "../Icon.astro";

interface Props {
  code: string;
  class?: string;
  /**
   * Replace the literal `<token>` with the visitor's own token from
   * /ais/token/, so a command can be copied and run as-is. Opt-in, because a
   * block that never mentions a token should not pay for the lookup.
   */
  token?: boolean;
}
const { code, class: className, token = false } = Astro.props;
---

<div class:list={["group relative", className]}>
  <div
    class="border-line bg-well text-fg overflow-x-auto rounded-xl border p-4 pr-14 font-mono"
  >
    {
      /* Token blocks wrap the way /ais/token/ does: a substituted token is
        300-odd unbroken characters, and scrolling sideways through one to
        check the end of a command is worse than a mid-token break. Blocks
        without a token keep scrolling, so the multi-line TypeScript and
        Swift samples on /sky/ are not broken mid-identifier. */
    }
    <pre
      class:list={[
        "text-sm",
        token && "break-all whitespace-pre-wrap",
      ]}><code data-code data-token={token ? "" : undefined}>{code}</code></pre>
  </div>
  <button
    type="button"
    data-copy
    title="Copy"
    aria-label="Copy to clipboard"
    class="border-line bg-surface text-fg-muted hover:text-fg absolute top-2 right-2 rounded-lg border p-2 opacity-0 transition group-focus-within:opacity-100 group-hover:opacity-100 focus-visible:opacity-100 max-sm:opacity-100"
  >
    <Icon name="mdi:content-copy" class="size-4" data-copy-icon />
    <span class="sr-only" data-copy-label>Copy</span>
  </button>
</div>

<script>
  import { TOKEN_PLACEHOLDER, onTokenChange } from "../../utils/aiscast-token";

  // Absent or expired means the commands keep showing `<token>`, which is what
  // someone who has not been to the token page needs to see.
  onTokenChange((t) => {
    for (const el of document.querySelectorAll<HTMLElement>(
      "[data-code][data-token]",
    )) {
      // Keep the placeholder form, so a revoked or expired token puts it back
      // and copying never depends on having run this first.
      el.dataset.template ??= el.textContent ?? "";
      const text = t
        ? el.dataset.template.replaceAll(TOKEN_PLACEHOLDER, t.token)
        : el.dataset.template;
      if (el.textContent !== text) el.textContent = text;
    }
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy]",
  )) {
    const code =
      button.parentElement?.querySelector<HTMLElement>("[data-code]");
    if (!code) continue;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
      } catch {
        return; // No clipboard permission: leave the label alone rather than lie.
      }
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      const icon = button.querySelector<SVGElement>("[data-copy-icon]");
      if (label) label.textContent = "Copied";
      button.title = "Copied";
      icon?.classList.add("text-accent");
      setTimeout(() => {
        if (label) label.textContent = "Copy";
        button.title = "Copy";
        icon?.classList.remove("text-accent");
      }, 1500);
    });
  }
</script>
