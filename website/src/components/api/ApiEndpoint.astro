---
import type { EndpointInfo } from "../../utils/openapi";
import Card from "../ui/Card.astro";
import { API_HOST } from "../../utils/constants.ts";
import { md, mdInline } from "../../utils/render-markdown.ts";

interface Props {
  endpoint: EndpointInfo;
  /** Origin the endpoint lives on; the main API host unless given. */
  host?: string;
  /** Anchor id, so navigation can link straight to this card. */
  id?: string;
}

const { endpoint, host = API_HOST, id } = Astro.props;

const methodColors: Record<string, string> = {
  GET: "bg-(--status-green-bg) text-(--status-green-text)",
  POST: "bg-(--status-blue-bg) text-(--status-blue-text)",
  PUT: "bg-(--status-yellow-bg) text-(--status-yellow-text)",
  PATCH: "bg-(--status-orange-bg) text-(--status-orange-text)",
  DELETE: "bg-(--status-red-bg) text-(--status-red-text)",
};

// OpenAPI descriptions are markdown.
const descriptionHtml = endpoint.description ? md(endpoint.description) : null;
const parameters = (endpoint.parameters ?? []).map((param) => ({
  ...param,
  descriptionHtml: param.description ? mdInline(param.description) : "",
}));

// text/plain examples are shown as written; everything else as JSON.
const formatExample = (value: unknown) =>
  value === undefined
    ? null
    : typeof value === "string"
      ? value
      : JSON.stringify(value, null, 2);

interface SchemaObject {
  type?: string;
  description?: string;
  required?: string[];
  properties?: Record<
    string,
    { type?: string; description?: string; default?: unknown }
  >;
}

const requestContent = Object.entries(endpoint.requestBody?.content ?? {}).map(
  ([contentType, media]) => {
    const schema = (media.schema ?? {}) as SchemaObject;
    return {
      contentType,
      descriptionHtml: schema.description ? mdInline(schema.description) : "",
      properties: Object.entries(schema.properties ?? {}).map(
        ([name, property]) => ({
          name,
          type: property.type ?? "",
          required: (schema.required ?? []).includes(name),
          descriptionHtml: property.description
            ? mdInline(property.description)
            : "",
        }),
      ),
      example: formatExample(media.example),
    };
  },
);

// Get example response from first successful response
const successResponse = Object.entries(endpoint.responses).find(([code]) =>
  code.startsWith("2"),
)?.[1];
const exampleResponse = formatExample(
  successResponse && "content" in successResponse
    ? Object.values(successResponse.content ?? {}).find((c) => c.example)
        ?.example
    : undefined,
);
---

<Card class="mb-6 scroll-mt-24" id={id}>
  <div class="space-y-4">
    <!-- Method and Path -->
    <div class="flex items-center gap-3">
      <span
        class={`rounded px-2 py-1 text-xs font-bold ${methodColors[endpoint.method] || "bg-(--surface-subtle) text-(--text)"}`}
      >
        {endpoint.method}
      </span>
      <span class="font-mono text-sm">{host}{endpoint.path}</span>
    </div>

    <!-- Summary and Description -->
    {endpoint.summary && <p class="font-medium">{endpoint.summary}</p>}
    {
      descriptionHtml && (
        <div
          class="prose max-w-none text-(--text-secondary)"
          set:html={descriptionHtml}
        />
      )
    }

    <!-- Parameters -->
    {
      parameters.length > 0 && (
        <div>
          <h4 class="mb-0 text-lg">Parameters</h4>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-(--surface-subtle)">
                <tr>
                  <th class="w-32 px-3 py-2 text-left">Name</th>
                  <th class="w-20 px-3 py-2 text-left">Location</th>
                  <th class="w-20 px-3 py-2 text-left">Type</th>
                  <th class="w-18 px-3 py-2 text-left">Required</th>
                  <th class="px-3 py-2 text-left">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-(--border-subtle)">
                {parameters.map((param) => (
                  <tr>
                    <td class="px-3 py-2 font-mono">{param.name}</td>
                    <td class="px-3 py-2">
                      <span class="rounded bg-(--surface-subtle) px-2 py-1 text-xs">
                        {param.in}
                      </span>
                    </td>
                    <td class="px-3 py-2 font-mono text-xs">
                      {param.schema && "type" in param.schema
                        ? param.schema.type
                        : ""}
                    </td>
                    <td class="px-3 py-2">
                      {param.required ? (
                        <span class="text-red-600">✓</span>
                      ) : (
                        <span class="text-navy-400">—</span>
                      )}
                    </td>
                    <td
                      class="px-3 py-2 text-(--text-secondary)"
                      set:html={param.descriptionHtml}
                    />
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    <!-- Request Body -->
    {
      requestContent.length > 0 && (
        <div>
          <h4 class="mb-0 text-lg">Request Body</h4>
          {requestContent.map((body) => (
            <div class="mt-2">
              {requestContent.length > 1 && (
                <p class="mb-1 font-mono text-xs text-(--text-muted)">
                  {body.contentType}
                </p>
              )}
              {body.descriptionHtml && (
                <p
                  class="mb-2 text-sm text-(--text-secondary)"
                  set:html={body.descriptionHtml}
                />
              )}
              {body.properties.length > 0 && (
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead class="bg-(--surface-subtle)">
                      <tr>
                        <th class="w-32 px-3 py-2 text-left">Field</th>
                        <th class="w-20 px-3 py-2 text-left">Type</th>
                        <th class="w-18 px-3 py-2 text-left">Required</th>
                        <th class="px-3 py-2 text-left">Description</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-(--border-subtle)">
                      {body.properties.map((property) => (
                        <tr>
                          <td class="px-3 py-2 font-mono">{property.name}</td>
                          <td class="px-3 py-2 font-mono text-xs">
                            {property.type}
                          </td>
                          <td class="px-3 py-2">
                            {property.required ? (
                              <span class="text-red-600">✓</span>
                            ) : (
                              <span class="text-navy-400">—</span>
                            )}
                          </td>
                          <td
                            class="px-3 py-2 text-(--text-secondary)"
                            set:html={property.descriptionHtml}
                          />
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {body.example !== null && (
                <div class="bg-navy-900 mt-3 overflow-x-auto rounded-lg p-4 text-white">
                  {/* prettier-ignore */}
                  <pre class="text-sm"><code>{body.example}</code></pre>
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }

    <!-- Example Response -->
    {
      exampleResponse && (
        <div>
          <h4>Example Response</h4>
          <div class="bg-navy-900 overflow-x-auto rounded-lg p-4 text-white">
            {/* prettier-ignore */}
            <pre class="text-sm"><code>{exampleResponse}</code></pre>
          </div>
        </div>
      )
    }
  </div>
</Card>
