---
interface Props {
  class?: string;
  center: [number, number]; // [lng, lat]
  zoom: number;
  interactive?: boolean;
}

const { class: className, center, zoom, interactive = true } = Astro.props;
---

<div
  class={className}
  data-seascape-map
  data-center={JSON.stringify(center)}
  data-zoom={zoom}
  data-interactive={String(interactive)}
>
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  document.querySelectorAll("[data-seascape-map]").forEach((el) => {
    const container = el as HTMLElement;
    const interactive = container.dataset.interactive !== "false";
    const map = new maplibregl.Map({
      container,
      style: "https://tiles.openwaters.io/seascape/style.json",
      center: JSON.parse(container.dataset.center ?? "[0,0]"),
      zoom: Number(container.dataset.zoom ?? 1),
      interactive,
      // don't hijack page scroll on full-width heroes
      cooperativeGestures: interactive,
      // 24 merged sources — expanded attribution would blanket the map
      attributionControl: interactive ? { compact: true } : false,
    });
    if (interactive) map.addControl(new maplibregl.NavigationControl());
    // compact attribution starts expanded; collapse it to the ⓘ toggle
    map.once("load", () => {
      container
        .querySelector(".maplibregl-ctrl-attrib")
        ?.classList.remove("maplibregl-compact-show");
    });
  });
</script>
