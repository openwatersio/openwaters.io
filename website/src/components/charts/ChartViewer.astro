---
interface Props {
  chart: "seascape" | "seamap";
}

const { chart } = Astro.props;

// Descriptions match each chart's page lead.
const about = {
  seascape: {
    name: "Seascape",
    description:
      "A map of the seafloor with contours, depth shading, and soundings.",
    href: "/charts/seascape",
  },
  seamap: {
    name: "Seamap",
    description: "A nautical-themed map with depths, seamarks, and hazards.",
    href: "/charts/seamap",
  },
}[chart];
---

{
  /* Positioning lives on the wrapper: MapLibre forces position:relative on its
    own container, which would override an `absolute` here and collapse it. */
}
<div class="absolute inset-0">
  <div id="map" data-chart={chart} class="h-full w-full"></div>
</div>

{
  /* Floats over the map, left-aligned under the site header, so the chart runs
    edge to edge behind it */
}
<div class="header-padding pointer-events-none absolute inset-x-0 top-0 z-10">
  <div class="flex items-start gap-3 p-4">
    <div
      class="card-glass pointer-events-auto mr-8 flex flex-wrap items-baseline gap-x-2 p-3 text-sm"
    >
      <span class="font-semibold">{about.name}</span>
      ·
      <span class="hidden text-(--text-secondary) sm:inline">
        {about.description}
      </span>
      <a
        href={about.href}
        class="font-medium text-(--accent) hover:text-(--accent-hover)">About</a
      >
    </div>
  </div>
</div>

{/* Bottom left, in place of MapLibre's scale bar */}
<div class="pointer-events-none absolute bottom-0 left-0 z-10 p-4">
  <div
    class="card-glass pointer-events-auto inline-flex gap-1 p-1! text-sm"
    role="group"
    aria-label="Depth units"
  >
    <button
      type="button"
      data-unit="m"
      aria-pressed="true"
      class="rounded px-3 py-1 font-medium"
    >
      m
    </button>
    <button
      type="button"
      data-unit="ft"
      aria-pressed="false"
      class="rounded px-3 py-1 font-medium"
    >
      ft
    </button>
  </div>
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  // Only the runtime helper: the styles themselves are fetched from the tile
  // server, so a chart restyle ships without redeploying the site. This drives
  // the seascape layers by id, which Seamap embeds under the same names.
  import { applyState, type Unit } from "@openwaters/seascape";

  const TILES = "https://tiles.openwaters.io";
  const SAFETY_DEPTH = 2; // metres, the style's own default

  const container = document.getElementById("map") as HTMLElement;
  const chart = (container.dataset.chart ?? "seascape") as
    "seascape" | "seamap";

  const map = new maplibregl.Map({
    container,
    style: `${TILES}/${chart}/style.json`,
    center: chart === "seascape" ? [-23, 65.4] : [10.24, 56.155],
    zoom: chart === "seascape" ? 9 : 12,
    hash: true,
    // A chart is read north-up and flat. dragRotate alone still leaves the
    // two-finger twist, shift+arrow keys, and two-finger pitch open.
    maxPitch: 0,
    dragRotate: false,
    pitchWithRotate: false,
    touchPitch: false,
    attributionControl: { compact: true },
  });
  map.touchZoomRotate.disableRotation();
  map.keyboard.disableRotation();
  // No compass: with the map locked north-up there's no bearing to reset.
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }));

  // ─── Depth units ──────────────────────────────────────────────────────────
  const unitButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-unit]"),
  );
  const ACTIVE = ["bg-(--accent)", "text-white"];
  const IDLE = [
    "cursor-pointer",
    "text-(--text-secondary)",
    "hover:text-(--text)",
  ];

  function setUnit(unit: Unit) {
    // seamap's style.json ships vector depth bands; applyState defaults
    // shading to "relief", which would filter the bands out above z6
    applyState(map, {
      unit,
      safety: SAFETY_DEPTH,
      shading: chart === "seamap" ? "bands" : "relief",
    });
    for (const button of unitButtons) {
      const on = button.dataset.unit === unit;
      button.setAttribute("aria-pressed", String(on));
      button.classList.remove(...ACTIVE, ...IDLE);
      button.classList.add(...(on ? ACTIVE : IDLE));
    }
  }

  for (const button of unitButtons)
    button.addEventListener("click", () =>
      setUnit(button.dataset.unit as Unit),
    );

  map.on("load", () => {
    if (chart === "seascape") {
      // Mapterhorn: open global terrain, far finer on land than the bathymetry
      // mosaic. Ocean is flat 0 there, so this shades land only. Attribution
      // rides in via its TileJSON. Seamap's style already carries land relief.
      map.addSource("mapterhorn", {
        type: "raster-dem",
        url: "https://tiles.mapterhorn.com/tilejson.json",
        tileSize: 512,
        encoding: "terrarium", // MapLibre doesn't read encoding from TileJSON
      });
      map.addLayer(
        {
          id: "land-hillshade",
          type: "hillshade",
          source: "mapterhorn",
          paint: {
            "hillshade-exaggeration": 0.3,
            "hillshade-shadow-color": "#8a7455",
            "hillshade-highlight-color": "#fffdf2",
            "hillshade-accent-color": "#b3a184",
          },
        },
        "contour-lines", // under the chart linework, over the land wash
      );
    }

    setUnit("m");
  });
</script>
