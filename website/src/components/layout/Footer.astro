---
import Logo from "./Logo.astro";
import { CONTACT_EMAIL } from "../../utils/constants";

const columns = [
  {
    title: "Projects",
    links: [
      { label: "Tides", href: "/tides/" },
      { label: "Charts", href: "/charts/" },
      { label: "AIS", href: "/ais/" },
      { label: "Sky", href: "/sky/" },
      { label: "Bathymetry", href: "/bathymetry/" },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "API reference", href: "/api/" },
      { label: "Tide database", href: "/tides/database/" },
      { label: "GitHub", href: "https://github.com/openwatersio" },
      { label: "Discord", href: "https://discord.gg/NeMyrYMGr" },
    ],
  },
  {
    title: "Open Waters",
    links: [
      { label: "About", href: "/about/" },
      { label: "License", href: "/license/" },
      { label: "Contact", href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-line bg-well mt-auto border-t">
  <div class="container-custom py-14">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="col-span-2 md:col-span-1">
        <a
          href="/"
          class="text-fg-strong hover:text-fg-strong flex items-center gap-2.5 text-lg font-semibold tracking-tight"
        >
          <Logo class="size-8" />
          Open Waters
        </a>
        <p class="text-fg-faint mt-3 max-w-xs text-sm">
          Open source marine software and data.
        </p>
      </div>
      {
        columns.map((column) => (
          <div>
            <h2 class="eyebrow text-fg-faint mb-4 text-[11px]">
              {column.title}
            </h2>
            <ul class="space-y-2.5 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-fg-muted hover:text-fg-strong"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="border-line text-fg-faint mt-12 flex flex-col gap-3 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {currentYear} Open Water Software, LLC. Some rights reserved.{" "}
        <a href="/license/" class="text-fg-muted hover:text-fg-strong">
          View license
        </a>
      </p>
      <p class="eyebrow text-fg-faint text-[11px]">
        Predictions · not for navigation
      </p>
    </div>
  </div>
</footer>
