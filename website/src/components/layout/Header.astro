---
import Icon from "../Icon.astro";
import Logo from "./Logo.astro";
import { cn } from "../../utils/cn";

const navItems = [
  { name: "Tides", href: "/tides/" },
  { name: "Charts", href: "/charts/" },
  { name: "AIS", href: "/ais/" },
  { name: "Sky", href: "/sky/" },
  { name: "Bathymetry", href: "/bathymetry/" },
  { name: "API", href: "/api/" },
  { name: "About", href: "/about/" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<header id="site-header">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6">
    <a
      href="/"
      class="text-fg-strong hover:text-fg-strong flex items-center gap-2.5 text-lg font-semibold tracking-tight"
    >
      <Logo class="size-8" />
      Open Waters
    </a>

    <ul class="hidden items-center gap-7 text-sm md:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class={cn(
                "hover:text-fg-strong font-medium",
                isCurrent(item.href) ? "text-fg-strong" : "text-fg-muted",
              )}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href="https://discord.gg/NeMyrYMGr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Discord"
        title="Join us on Discord"
        class="text-fg-muted hover:text-fg-strong focus-visible:outline-accent -m-2 rounded-lg p-2 focus-visible:outline-2"
      >
        <Icon name="mdi:discord" class="size-5" />
      </a>
      <a
        href="https://github.com/openwatersio"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        title="View on GitHub"
        class="text-fg-muted hover:text-fg-strong focus-visible:outline-accent -m-2 rounded-lg p-2 focus-visible:outline-2"
      >
        <Icon name="mdi:github" class="size-5" />
      </a>
    </div>

    <button
      id="mobile-menu-button"
      class="text-fg-muted hover:text-fg-strong focus-visible:outline-accent -m-2 rounded-lg p-2 focus-visible:outline-2 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="mdi:menu" class="size-6" />
    </button>
  </nav>

  <ul id="mobile-menu" class="mt-3 hidden space-y-1 pb-3 md:hidden">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class={cn(
              "block rounded-lg px-3 py-2 font-medium",
              isCurrent(item.href)
                ? "bg-surface text-fg-strong"
                : "text-fg-muted hover:bg-surface hover:text-fg-strong",
            )}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });

  const header = document.getElementById("site-header");
  const updateHeader = () =>
    header?.classList.toggle("scrolled", window.scrollY > 0);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>
