{
  "name": "openwaters-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "website",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w website\" \"npm run dev -w api\"",
    "dev:website": "npm run dev -w website",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w website"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@slackwater/api": "^1.0.0-beta.0",
    "@slackwater/database": "^1.0.0-beta.0",
    "@slackwater/engine": "^1.0.0-beta.0",
    "@slackwater/react": "^1.0.0-beta.0",
    "slackwater": "^1.0.0-beta.0"
  }
}
