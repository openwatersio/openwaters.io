{
  "name": "openwaters-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "website",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w website\" \"npm run dev -w api\"",
    "dev:website": "npm run dev -w website",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w website"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@slackwater/api": "https://pkg.pr.new/openwatersio/neaps/@slackwater/api@339",
    "@slackwater/database": "https://pkg.pr.new/openwatersio/tide-database/@slackwater/database@192",
    "@slackwater/engine": "https://pkg.pr.new/openwatersio/neaps/@slackwater/engine@339",
    "@slackwater/react": "https://pkg.pr.new/openwatersio/neaps/@slackwater/react@339",
    "slackwater": "https://pkg.pr.new/openwatersio/neaps/slackwater@339"
  }
}
