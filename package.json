{
  "name": "openwaters-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "website",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w website\" \"npm run dev -w api\"",
    "dev:website": "npm run dev -w website",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w website"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@neaps/api": "^0.7.0",
    "@neaps/react": "^0.2.0",
    "@neaps/tide-database": "^0.9.20260801",
    "@neaps/tide-predictor": "^0.11.0",
    "neaps": "^0.8.0"
  }
}
