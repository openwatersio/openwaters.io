{
  "name": "openwaters-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "website",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w website\" \"npm run dev -w api\"",
    "dev:website": "npm run dev -w website",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w website",
    "check:gateway": "wrangler types -c gateway/wrangler.jsonc gateway/worker-configuration.d.ts && tsc -p gateway"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@slackwater/api": "https://pkg.pr.new/@slackwater/api@5062f83",
    "@slackwater/database": "^1.0.0-beta.20261102",
    "@slackwater/engine": "^1.0.0-beta.0",
    "slackwater": "https://pkg.pr.new/openwatersio/slackwater/slackwater@5062f83"
  },
  "overrides": {
    "slackwater": "$slackwater"
  }
}
