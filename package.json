{
  "name": "openwaters-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "website",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w website\" \"npm run dev -w api\"",
    "dev:website": "npm run dev -w website",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w website"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "@neaps/api": "^0.6.0",
    "@neaps/react": "^0.1.1",
    "@neaps/tide-database": "^0.8.20260701",
    "@neaps/tide-predictor": "^0.10.0",
    "neaps": "^0.7.0"
  }
}
